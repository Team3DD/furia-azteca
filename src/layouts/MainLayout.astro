---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  class?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Selección Mexicana de Aficionados Comunidad oficial de fans de México 2026.',
  ogImage = '/og-default.jpg',
  class: className,
  noIndex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.site).href;

const robotsContent = noIndex ? 'noindex, nofollow' : 'index, follow';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <title>{title} | International Fans Cup</title>

    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content="International Fans Cup" />
    <meta name="theme-color" content="#1a2a3a" />

    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | International Fans Cup`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="International Fans Cup" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={`${title} | International Fans Cup`}
    />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Flag Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flag-icons@6.11.0/css/flag-icons.min.css"
    />

    <!-- Elfsight Instagram Feed -->
    <script
      src="https://elfsightcdn.com/platform.js"
      async
    ></script>

    <!-- Schema.org -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SportsOrganization",
        "name": "International Fans Cup",
        "url": "https://internationalfanscup.com",
        "logo": "https://internationalfanscup.com/logo.PNG",
        "sameAs": [
          "https://www.instagram.com/internationalfanscup",
          "https://www.facebook.com/internationalfanscup",
          "https://twitter.com/internationalfanscup"
        ]
      }
    </script>
  </head>

  <body class:list={['min-h-screen flex flex-col', className]}>
    <!-- Accesibilidad -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-dorado focus:text-carbon focus:font-display focus:text-sm focus:uppercase focus:tracking-widest"
    >
      Saltar al contenido
    </a>

    <Header />

    <main
      id="main-content"
      class="flex-1"
      tabindex="-1"
    >
      <slot />
    </main>

    <Footer />
  </body>
</html>