---
// src/components/sections/MundialesStrip.astro

const ediciones = [
  {
    year: 'Rusia 2018',
    title: 'La primera vez',
    description: 'Primera participación organizada de aficionados mexicanos en una Copa del Mundo. El inicio del movimiento.',
    href: '/#formulario',
    color: 'from-rojo/80',
    badge: 'Historia',
  },
  {
    year: 'Qatar 2022',
    title: 'International Fans Cup',
    description: 'Elegidos como el mejor torneo de fans del Mundial. Participación varonil y femenil. El punto más alto hasta ahora.',
    href: '/#formulario',
    color: 'from-verde/80',
    badge: 'Mejor torneo',
  },
  {
    year: 'IFC 2026',
    title: 'Iniciamos el 28 de junio',
    description: 'eres medio de comunicación mandanos un whats app o un correo a hola@furiaazteca.com',
    href: 'mailto:hola@furiaazteca.com', 
    color: 'from-dorado/80',
    badge: 'Próximamente',
  }
];
---

<section class="py-24 bg-crema-dark" aria-labelledby="mundiales-title">
  <div class="max-w-7xl mx-auto px-6">

    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <p class="section-label mb-2">Nuestras ediciones</p>
        <h2 id="mundiales-title" class="section-title text-carbon">
          Tres mundiales.<br/>Una pasión.
        </h2>
      </div>
      <a href="/#historia" class="text-carbon font-display text-lg uppercase tracking-widest hover:text-verde-dark transition-colors self-end">
        Ver historia completa
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6 md:gap-8">
      {ediciones.map(({ year, title, description, href, badge }) => (
        <a
          href={href}
          class="group relative overflow-hidden bg-carbon border border-white/10 block transition-all duration-200 rhomboid-corners-only hover:bg-dorado hover:border-dorado"
          aria-label={`Ver ${year}: ${title}`}
        >
          <!-- Patrón sutil -->
          <div class="absolute inset-0 opacity-5 z-0"
              style="background-image: radial-gradient(circle, white 5px, transparent 10px); background-size: 24px 24px;">
          </div>

          <!-- Badge esquina superior izquierda (ya no es absolute, pero lo dejamos con position absolute pero añadimos padding-top al contenido) -->
          <div class="absolute top-4 sm:top-6 left-4 sm:left-6 z-10">
            <span class="rhomboid-corners-only inline-block font-display text-xs sm:text-sm uppercase tracking-widest bg-dorado text-carbon group-hover:bg-carbon group-hover:text-crema px-2 py-1 sm:px-3 sm:py-1 transition-all duration-200">
              {badge}
            </span>
          </div>

          <!-- Contenido: añadimos padding-top suficiente para que el badge no se superponga -->
          <div class="relative z-20 h-full flex flex-col justify-end pt-16 sm:pt-20 pb-6 sm:pb-8 px-6 sm:px-8">
            <p class="font-display text-xs sm:text-sm uppercase tracking-[0.25em] text-dorado/70 group-hover:text-carbon mb-2 sm:mb-3 transition-colors duration-200">
              {year}
            </p>
            <h3 class="font-display text-crema text-2xl sm:text-3xl uppercase leading-tight mb-3 sm:mb-4 group-hover:text-carbon transition-colors duration-200">
              {title}
            </h3>
            <p class="font-body text-crema/50 text-sm sm:text-base leading-relaxed mb-6 sm:mb-8 group-hover:text-carbon/70 transition-colors duration-200">
              {description}
            </p>
            <span class="font-display text-xs uppercase tracking-widest text-dorado flex items-center gap-2 group-hover:text-carbon group-hover:gap-3 transition-all duration-200">
              Explorar
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>