---
// src/components/sections/HeroSection.astro
import { Button } from "../ui/button";
---

<section
  class="relative min-h-[92vh] flex items-center overflow-hidden bg-carbon"
  aria-labelledby="hero-title"
>
  <!-- Fondos y acentos (sin cambios) -->
  <div class="absolute inset-0 bg-gradient-azteca opacity-60" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[url('/images/hero-bg.jpg')] bg-cover bg-center opacity-20 mix-blend-luminosity" aria-hidden="true"></div>
  <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true"
       style="background-image: repeating-linear-gradient(0deg, transparent, transparent 40px, white 40px, white 41px), repeating-linear-gradient(90deg, transparent, transparent 40px, white 40px, white 41px);">
  </div>
  <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-verde via-dorado to-rojo" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-6 py-24 grid lg:grid-cols-2 gap-12 items-center w-full">
    <div class="space-y-7">
      <div class="flex items-center gap-3">
        <span class="section-label">Selección Mexicana de Aficionados</span>
        <span class="h-px flex-1 bg-dorado/30 max-w-12"></span>
      </div>

      <h1 id="hero-title" class="font-display text-white uppercase leading-none">
        <span class="block text-5xl md:text-7xl">Furia</span>
        <span class="block text-5xl md:text-7xl text-stroke-verde">Azteca</span>
        <span class="block text-xl md:text-2xl text-white/40 mt-3 tracking-widest">
          La pasión hecha selección
        </span>
      </h1>

      <p class="font-body text-white/60 text-lg leading-relaxed max-w-md">
        Somos la comunidad oficial de aficionados mexicanos que ha llevado los colores de México a Rusia 2018, Qatar 2022 y ahora va por el Mundial 2026.
      </p>

      <div class="flex flex-wrap gap-4 pt-2">
        <Button href="/unete" variant="solid" color="dorado" size="lg" client:load>
          Únete al movimiento →
        </Button>
        <Button 
          href="/historia" 
          variant="outline" 
          color="verde" 
          size="lg" 
          
          client:load
        >
          Ver historia
        </Button>
      </div>

      <!-- Indicadores de ediciones (sin cambios) -->
      <div class="flex items-center gap-6 pt-4 border-t border-white/10">
        {[
          { year: '2018', place: 'Rusia', href: '/mundiales/rusia-2018' },
          { year: '2022', place: 'Qatar', href: '/mundiales/qatar-2022' },
          { year: '2026', place: 'MX · USA · CA', href: '/mundiales/2026' },
        ].map(({ year, place, href }) => (
          <a href={href} class="group text-center">
            <span class="block font-display text-dorado text-lg leading-none group-hover:text-dorado-light transition-colors">
              {year}
            </span>
            <span class="block font-body text-white/30 text-xs mt-0.5 tracking-widest uppercase">
              {place}
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Bloque visual derecho (sin cambios) -->
    <div class="hidden lg:flex flex-col gap-4 items-end">
      <div class="w-full max-w-sm bg-white/5 border border-white/10 p-6 backdrop-blur-sm">
        <span class="section-label">Mejor torneo de fans</span>
        <p class="font-display text-white text-2xl uppercase mt-2 leading-none">
          International<br/>Fans Cup
        </p>
        <p class="text-white/40 text-sm font-body mt-2">Qatar 2022 — Participación varonil y femenil</p>
        <a href="/mundiales/qatar-2022" class="inline-flex items-center gap-2 text-dorado text-sm font-display uppercase tracking-widest mt-4 hover:gap-3 transition-all">
          Ver edición <span>→</span>
        </a>
      </div>
      <div class="w-full max-w-sm bg-verde/20 border border-verde/40 p-4 flex items-center gap-4">
        <div class="w-10 h-10 bg-verde flex items-center justify-center shrink-0">
          <span class="font-display text-white text-xs font-bold">26</span>
        </div>
        <div>
          <p class="font-display text-white uppercase text-sm tracking-widest">Mundial 2026</p>
          <p class="font-body text-white/40 text-xs">México · Estados Unidos · Canadá</p>
        </div>
        <a href="/mundiales/2026" class="ml-auto text-verde-light hover:text-white transition-colors text-sm">→</a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce" aria-hidden="true">
    <span class="font-display text-white/20 text-xs uppercase tracking-widest">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-white/20 to-transparent"></div>
  </div>
</section>

<style>
  .text-stroke-verde {
    -webkit-text-stroke: 2px var(--color-verde);
    color: transparent;
  }
</style>