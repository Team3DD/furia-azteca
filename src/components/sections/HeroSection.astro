---
// src/components/sections/HeroSection.astro
import { Button } from "../ui/button";
---

<section
  class="relative min-h-[92vh] flex items-center overflow-hidden bg-carbon"
  aria-labelledby="hero-title"
>
  <!-- VIDEO DE FONDO - ruta corregida -->
  <div class="absolute inset-0 w-full h-full overflow-hidden">
    <video
      class="absolute top-1/2 left-1/2 min-w-full min-h-full w-auto h-auto object-cover -translate-x-1/2 -translate-y-1/2"
      src="/video.mp4"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster="/images/hero-bg.webp"
    >
      <!-- Fallback si el navegador no soporta video -->
      <img src="/images/hero-bg.webp" alt="Background" class="w-full h-full object-cover" />
    </video>
  </div>

  <!-- Overlays -->
  <div class="absolute inset-0 bg-gradient-azteca opacity-60" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-black/30" aria-hidden="true"></div>
  <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true"
       style="background-image: repeating-linear-gradient(0deg, transparent, transparent 40px, white 40px, white 41px), repeating-linear-gradient(90deg, transparent, transparent 40px, white 40px, white 41px);">
  </div>

  <!-- Contenedor con márgenes amplios -->
  <div class="relative w-full max-w-8xl mx-auto px-6 md:px-10 lg:px-12 grid lg:grid-cols-2 gap-12 items-center">
    <div class="space-y-8">
      <div class="flex items-center gap-3 mt-28">
        <span class="section-label">Selección Mexicana de Aficionados</span>
      </div>

      <h1 id="hero-title" class="font-display text-white uppercase leading-none">
        <span class="block text-5xl md:text-7xl"> International</span>
        <span class="block text-5xl md:text-7xl"> Fans Cup</span>
        <span class="block text-xl md:text-2xl text-white/40 mt-3 tracking-widest">
          From Fans to Fans 
        </span>
      </h1>

      <p class="font-body text-white/60 text-md leading-relaxed max-w-md">
        Somos una comunidad de aficionados internacionales que desde hace 12 años buscan promover el deporte más hermoso del mundo y la hermandad entre naciones jugando un torneo cada 4 años en el marco de la justa deportiva del deporte mas hermoso del mundo - NO ESTAMOS AFILIADOS NI ASOCIADOS DE NINGUNA FORMA A LA FIFA WORLD CUP ™️ este es un torneo de fans independiente from fans to fans. 
      </p>

      <div class="flex flex-wrap gap-4 pt-2">
        <Button href="/#formulario" variant="solid" color="dorado" size="lg">
          Registro        </Button>
        <Button 
          href="/#historia" 
          variant="outline" 
          color="verde" 
          size="lg" 
          className="!border-white/30 !text-white hover:!bg-white hover:!text-carbon"
        >
          Historia
        </Button>
      </div>

      <!-- Indicadores de ediciones -->
      <div class="flex items-center gap-6 pt-4">
        {[
          { year: '2018', place: 'Rusia', href: '/mundiales/rusia-2018' },
          { year: '2022', place: 'Qatar', href: '/mundiales/qatar-2022' },
          { year: '2026', place: 'MX · USA · CA', href: '/mundiales/2026' },
          { year: 'Aviso', place: 'de privacidad', href: 'https://furiaazteca.com/' },
        ].map(({ year, place, href }) => (
          <a href={href} class="group text-center">
            <span class="block font-display text-dorado text-lg leading-none group-hover:text-dorado-light transition-colors">
              {year}
            </span>
            <span class="block font-body text-white/30 text-xs mt-0.5 tracking-widest uppercase">
              {place}
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Bloque visual derecho (solo desktop) -->
    <div class="hidden lg:flex flex-col gap-6 items-end mt-20">

      <!-- Tarjeta 1 -->
      <a href="/#formulario" class="rhomboid rhomboid-corners rhomboid-hover w-full max-w-sm bg-white/5 border border-white/10 p-6 backdrop-blur-sm block">
        <div class="rhomboid-content flex flex-col items-center text-center">
          <span class="section-label text-sm tracking-[0.3em]">Mejor torneo de fans</span>
          <p class="font-display text-white text-4xl uppercase mt-3 leading-none">
            Registro <br/>Internacional
          </p>
          <p class="text-white/40 text-base font-body mt-3">Registro de equipos</p>
          <span class="inline-flex items-center gap-2 text-dorado text-sm font-display uppercase tracking-widest mt-5">
            Registro de capitanes
          </span>
        </div>
      </a>

      <!-- Tarjeta 2 -->
      <a href="/#historia" class="rhomboid rhomboid-corners rhomboid-hover w-full max-w-sm bg-dorado/20 border border-dorado/40 p-5 block">
        <div class="rhomboid-content flex flex-col items-center text-center gap-3">
          <div class="w-12 h-12 bg-dorado flex items-center justify-center shrink-0">
            <span class="font-display text-white text-sm font-bold">26</span>
          </div>
          <div>
            <p class="font-display text-white uppercase text-lg tracking-widest">
              Mundialito de Fans Mexico City
            </p>
            <p class="font-body text-white/40 text-sm mt-1">
              México · Estados Unidos · Canadá
            </p>
          </div>
        </div>
      </a>

      <!-- Imagen -->
      <div class="w-full max-w-sm flex justify-center mt-2">
        <img
          src="/furia.png"
          alt="Furia Azteca"
          class="w-full max-w-[130px] h-auto object-contain"
        />
      </div>

    </div>

  </div>

  
</section>