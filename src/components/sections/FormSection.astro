// ----- DOM elements -----
const radioMexicano = document.querySelector('input[value="mexicano"]');
const radioInternacional = document.querySelector('input[value="internacional"]');
const countryGroup = document.getElementById('countryGroup');
const customSelectBtn = document.getElementById('customSelectBtn');
const customSelectDropdown = document.getElementById('customSelectDropdown');
const customSelectContainer = document.getElementById('customSelectContainer');
const selectedCountryDisplay = document.getElementById('selectedCountryDisplay');
const countryValueHidden = document.getElementById('countryValue');
const firstNameInput = document.getElementById('firstName');
const lastNameInput = document.getElementById('lastName');
const phoneInput = document.getElementById('phone');
const emailInput = document.getElementById('email');
const actionBtn = document.getElementById('actionBtn');
const formStatus = document.getElementById('formStatus');
const playersSection = document.getElementById('playersSection');
const playersContainer = document.getElementById('playersContainer');
const addPlayerBtn = document.getElementById('addPlayerBtn');
const removeLastPlayerBtn = document.getElementById('removeLastPlayerBtn');
const modal = document.getElementById('customModal');
const modalMessage = document.getElementById('modalMessage');
const closeModalBtn = document.getElementById('closeModalBtn');

// ----- Estado -----
let players = [];     // contendrá objetos { nombre, apellido }
let step = 'players_list'; // 'players_list' o 'submit'

// ----- Modal helper -----
function showModal(message) {
  if (modal && modalMessage) {
    modalMessage.innerText = message;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
}

if (closeModalBtn) {
  closeModalBtn.addEventListener('click', function() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });
}
if (modal) {
  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });
}

// ----- Validar datos del capitán -----
function validatePersonalData() {
  const firstName = firstNameInput ? firstNameInput.value.trim() : '';
  const lastName = lastNameInput ? lastNameInput.value.trim() : '';
  const phone = phoneInput ? phoneInput.value.trim() : '';
  const email = emailInput ? emailInput.value.trim() : '';
  if (!firstName || !lastName || !phone || !email) {
    showModal('Todos los campos personales son obligatorios (nombre, apellido, teléfono, correo).');
    return false;
  }
  if (email.indexOf('@') === -1) {
    showModal('Correo electrónico no válido.');
    return false;
  }
  const playerTypeRadio = document.querySelector('input[name="playerType"]:checked');
  const playerType = playerTypeRadio ? playerTypeRadio.value : null;
  if (playerType === 'internacional') {
    const country = countryValueHidden ? countryValueHidden.value : '';
    if (!country) {
      showModal('Por favor selecciona tu país de origen.');
      return false;
    }
  }
  return true;
}

// ----- Escapar HTML -----
function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/[&<>]/g, function(m) {
    if (m === '&') return '&amp;';
    if (m === '<') return '&lt;';
    if (m === '>') return '&gt;';
    return m;
  });
}

// ----- Renderizar lista de jugadores -----
function renderPlayers() {
  if (!playersContainer) return;
  playersContainer.innerHTML = '';
  players.forEach(function(player, idx) {
    const playerDiv = document.createElement('div');
    playerDiv.className = 'grid md:grid-cols-2 gap-4 p-4 bg-carbon/40 rounded-lg border border-crema/10';
    playerDiv.innerHTML = `
      <div>
        <label class="block text-xs uppercase text-dorado mb-1">Nombre Jugador ${idx+1}</label>
        <input type="text" class="player-name w-full bg-carbon border border-crema/20 rounded-lg px-3 py-2 text-crema focus:outline-none focus:border-dorado" value="${escapeHtml(player.nombre)}" data-index="${idx}" data-field="nombre">
      </div>
      <div>
        <label class="block text-xs uppercase text-dorado mb-1">Apellido Jugador ${idx+1}</label>
        <input type="text" class="player-lastname w-full bg-carbon border border-crema/20 rounded-lg px-3 py-2 text-crema focus:outline-none focus:border-dorado" value="${escapeHtml(player.apellido)}" data-index="${idx}" data-field="apellido">
      </div>
    `;
    playersContainer.appendChild(playerDiv);
  });

  // Actualizar array al editar
  document.querySelectorAll('.player-name').forEach(function(input) {
    input.addEventListener('input', function(e) {
      const target = e.target;
      const idx = parseInt(target.getAttribute('data-index') || '0', 10);
      if (!isNaN(idx) && players[idx]) players[idx].nombre = target.value;
    });
  });
  document.querySelectorAll('.player-lastname').forEach(function(input) {
    input.addEventListener('input', function(e) {
      const target = e.target;
      const idx = parseInt(target.getAttribute('data-index') || '0', 10);
      if (!isNaN(idx) && players[idx]) players[idx].apellido = target.value;
    });
  });
}

function initPlayers(amount) {
  amount = amount || 7;
  players = [];
  for (let i = 0; i < amount; i++) {
    players.push({ nombre: '', apellido: '' });
  }
  renderPlayers();
}

function addPlayer() {
  if (players.length >= 20) {
    showModal('Ya has alcanzado el máximo de 20 jugadores.');
    return false;
  }
  players.push({ nombre: '', apellido: '' });
  renderPlayers();
  return true;
}

function removeLastPlayer() {
  if (players.length <= 1) {
    showModal('Debes tener al menos 1 jugador. Para cumplir el mínimo agrega más usando el botón +');
    return false;
  }
  players.pop();
  renderPlayers();
  return true;
}

function validatePlayersList() {
  if (players.length < 7) {
    showModal('Te faltan ' + (7 - players.length) + ' jugadores. Debes registrar al menos 7.');
    return false;
  }
  if (players.length > 20) {
    showModal('Excedes el número de jugadores. Máximo 20 (actual: ' + players.length + ').');
    return false;
  }
  for (let i = 0; i < players.length; i++) {
    if (!players[i].nombre.trim() || !players[i].apellido.trim()) {
      showModal('El jugador ' + (i+1) + ' debe tener nombre y apellido completos.');
      return false;
    }
  }
  return true;
}

function submitFinal() {
  if (!validatePersonalData()) return;
  if (!validatePlayersList()) return;

  const firstName = firstNameInput ? firstNameInput.value.trim() : '';
  const lastName = lastNameInput ? lastNameInput.value.trim() : '';
  const phone = phoneInput ? phoneInput.value.trim() : '';
  const email = emailInput ? emailInput.value.trim() : '';
  const playerTypeRadio = document.querySelector('input[name="playerType"]:checked');
  const playerType = playerTypeRadio ? playerTypeRadio.value : '';
  let country = '';
  if (playerType === 'internacional') {
    country = countryValueHidden ? countryValueHidden.value : '';
  } else {
    country = 'México';
  }

  let playersListStr = '';
  players.forEach(function(p, idx) {
    playersListStr += 'Jugador ' + (idx+1) + ': ' + p.nombre + ' ' + p.apellido + '\n';
  });

  // WhatsApp
  const message = 'Nuevo registro International Fans Cup%0A%0A' +
    '*Tipo:* ' + (playerType === 'mexicano' ? 'Mexicano' : 'Internacional') + '%0A' +
    '*Nombre Capitán:* ' + firstName + ' ' + lastName + '%0A' +
    '*País:* ' + country + '%0A' +
    '*Teléfono:* ' + phone + '%0A' +
    '*Email:* ' + email + '%0A%0A' +
    '*LISTA DE JUGADORES (' + players.length + ')*%0A' +
    encodeURIComponent(playersListStr);
  window.open('https://wa.me/' + WHATSAPP_NUMBER + '?text=' + message, '_blank');

  // Correo
  const subject = encodeURIComponent('Registro IFC - ' + firstName + ' ' + lastName);
  const body = encodeURIComponent(
    'Nuevo registro\n\n' +
    'Tipo: ' + (playerType === 'mexicano' ? 'Mexicano' : 'Internacional') + '\n' +
    'Nombre Capitán: ' + firstName + ' ' + lastName + '\n' +
    'País: ' + country + '\n' +
    'Teléfono: ' + phone + '\n' +
    'Email: ' + email + '\n\n' +
    'LISTA DE JUGADORES (' + players.length + '):\n' + playersListStr
  );
  window.open('mailto:' + EMAIL_DESTINO + '?subject=' + subject + '&body=' + body, '_blank');

  if (formStatus) {
    formStatus.textContent = '✅ Se abrirán WhatsApp y tu correo. ¡Gracias por registrarte!';
    formStatus.classList.remove('hidden', 'bg-red-600/20', 'border-red-600');
    formStatus.classList.add('bg-green-600/20', 'border', 'border-green-600', 'text-green-200');
    setTimeout(function() { formStatus.classList.add('hidden'); }, 6000);
  }

  // Reset completo
  const form = document.getElementById('playerForm');
  if (form && form.reset) form.reset();
  if (countryGroup) countryGroup.classList.add('hidden');
  if (radioMexicano) radioMexicano.checked = true;
  if (selectedCountryDisplay) {
    selectedCountryDisplay.innerHTML = '<span class="fi fi-mx w-5 h-5"></span><span>México</span>';
  }
  if (countryValueHidden) countryValueHidden.value = '';
  if (customSelectDropdown) customSelectDropdown.classList.add('hidden');
  if (playersSection) playersSection.classList.add('hidden');
  players = [];
  renderPlayers();
  step = 'players_list';
  const actionBtnSpan = actionBtn ? actionBtn.querySelector('.rhomboid-content') : null;
  if (actionBtnSpan) actionBtnSpan.innerHTML = 'Lista de jugadores';
}

function onMainAction() {
  if (step === 'players_list') {
    if (!validatePersonalData()) return;
    initPlayers(7);
    if (playersSection) playersSection.classList.remove('hidden');
    step = 'submit';
    const actionBtnSpan = actionBtn ? actionBtn.querySelector('.rhomboid-content') : null;
    if (actionBtnSpan) actionBtnSpan.innerHTML = 'Enviar solicitud';
    if (playersSection) playersSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  } else {
    submitFinal();
  }
}

// ----- Inicialización (lazy load cuando el DOM está listo) -----
function initForm() {
  // Mostrar/ocultar selector de país según tipo de jugador
  if (radioMexicano && radioInternacional) {
    radioMexicano.addEventListener('change', function() {
      if (radioMexicano.checked && countryGroup) countryGroup.classList.add('hidden');
    });
    radioInternacional.addEventListener('change', function() {
      if (radioInternacional.checked && countryGroup) countryGroup.classList.remove('hidden');
    });
  }

  // Construir dropdown de países
  function buildDropdown() {
    if (!customSelectDropdown) return;
    const container = customSelectDropdown.querySelector('div');
    if (!container) return;
    container.innerHTML = '';
    paises.forEach(function(pais) {
      const optionDiv = document.createElement('div');
      optionDiv.className = 'flex items-center gap-2 px-4 py-2 hover:bg-dorado/20 cursor-pointer transition-colors rounded';
      optionDiv.innerHTML = '<span class="' + pais.flag + ' w-5 h-5"></span><span>' + pais.nombre + '</span>';
      optionDiv.addEventListener('click', function() {
        if (selectedCountryDisplay) {
          selectedCountryDisplay.innerHTML = '<span class="' + pais.flag + ' w-5 h-5"></span><span>' + pais.nombre + '</span>';
        }
        if (countryValueHidden) countryValueHidden.value = pais.nombre;
        if (customSelectDropdown) customSelectDropdown.classList.add('hidden');
      });
      container.appendChild(optionDiv);
    });
  }

  if (customSelectBtn && customSelectDropdown && customSelectContainer) {
    customSelectBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      customSelectDropdown.classList.toggle('hidden');
    });
    document.addEventListener('click', function(e) {
      if (customSelectContainer && !customSelectContainer.contains(e.target)) {
        if (customSelectDropdown) customSelectDropdown.classList.add('hidden');
      }
    });
  }
  buildDropdown();

  if (addPlayerBtn) addPlayerBtn.addEventListener('click', addPlayer);
  if (removeLastPlayerBtn) removeLastPlayerBtn.addEventListener('click', removeLastPlayer);
  if (actionBtn) actionBtn.addEventListener('click', onMainAction);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initForm);
} else {
  initForm();
}
