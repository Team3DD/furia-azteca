// ----- DOM elements -----
const countryGroup = document.getElementById('countryGroup');
const customSelectBtn = document.getElementById('customSelectBtn');
const customSelectDropdown = document.getElementById('customSelectDropdown');
const customSelectContainer = document.getElementById('customSelectContainer');
const selectedCountryDisplay = document.getElementById('selectedCountryDisplay');
const countryValueHidden = document.getElementById('countryValue');
const firstNameInput = document.getElementById('firstName');
const lastNameInput = document.getElementById('lastName');
const phoneInput = document.getElementById('phone');
const emailInput = document.getElementById('email');
const instagramInput = document.getElementById('instagram');
const facebookInput = document.getElementById('facebook');
const actionBtn = document.getElementById('actionBtn');
const formStatus = document.getElementById('formStatus');
const modal = document.getElementById('customModal');
const modalMessage = document.getElementById('modalMessage');
const closeModalBtn = document.getElementById('closeModalBtn');

// Ya no se usan variables relacionadas con jugadores
// const playersSection, playersContainer, addPlayerBtn, removeLastPlayerBtn, etc.

// ----- Modal helper -----
function showModal(message) {
  if (modal && modalMessage) {
    modalMessage.innerText = message;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
}

if (closeModalBtn) {
  closeModalBtn.addEventListener('click', function() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });
}
if (modal) {
  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });
}

// ----- Validar datos del capitán (obligatorios) -----
function validatePersonalData() {
  const firstName = firstNameInput ? firstNameInput.value.trim() : '';
  const lastName = lastNameInput ? lastNameInput.value.trim() : '';
  const phone = phoneInput ? phoneInput.value.trim() : '';
  const email = emailInput ? emailInput.value.trim() : '';
  if (!firstName || !lastName || !phone || !email) {
    showModal('Todos los campos personales son obligatorios (nombre, apellido, teléfono, correo).');
    return false;
  }
  if (email.indexOf('@') === -1) {
    showModal('Correo electrónico no válido.');
    return false;
  }
  // Validar país
  const country = countryValueHidden ? countryValueHidden.value : '';
  if (!country) {
    showModal('Por favor selecciona tu país de origen.');
    return false;
  }
  return true;
}

// ----- Escapar HTML (por si se usa en algún mensaje) -----
function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/[&<>]/g, function(m) {
    if (m === '&') return '&amp;';
    if (m === '<') return '&lt;';
    if (m === '>') return '&gt;';
    return m;
  });
}

// ----- Envío final (solo capitán + redes) -----
function submitFinal() {
  if (!validatePersonalData()) return;

  const firstName = firstNameInput ? firstNameInput.value.trim() : '';
  const lastName = lastNameInput ? lastNameInput.value.trim() : '';
  const phone = phoneInput ? phoneInput.value.trim() : '';
  const email = emailInput ? emailInput.value.trim() : '';
  const country = countryValueHidden ? countryValueHidden.value : '';
  const instagram = instagramInput ? instagramInput.value.trim() : '';
  const facebook = facebookInput ? facebookInput.value.trim() : '';

  // Construir mensaje para WhatsApp y correo
  let messageBody = 
    'Nuevo registro International Fans Cup%0A%0A' +
    '*Nombre Capitán:* ' + firstName + ' ' + lastName + '%0A' +
    '*País:* ' + country + '%0A' +
    '*Teléfono:* ' + phone + '%0A' +
    '*Email:* ' + email + '%0A';
  
  if (instagram) messageBody += '*Instagram:* ' + instagram + '%0A';
  if (facebook) messageBody += '*Facebook:* ' + facebook + '%0A';
  
  // WhatsApp
  window.open('https://wa.me/' + WHATSAPP_NUMBER + '?text=' + messageBody, '_blank');

  // Correo (sin saltos %0A, se usa encodeURIComponent para cuerpo legible)
  const subject = encodeURIComponent('Registro IFC - ' + firstName + ' ' + lastName);
  const emailBody = 
    'Nuevo registro\n\n' +
    'Nombre Capitán: ' + firstName + ' ' + lastName + '\n' +
    'País: ' + country + '\n' +
    'Teléfono: ' + phone + '\n' +
    'Email: ' + email + '\n' +
    (instagram ? 'Instagram: ' + instagram + '\n' : '') +
    (facebook ? 'Facebook: ' + facebook + '\n' : '');
  
  window.open('mailto:' + EMAIL_DESTINO + '?subject=' + subject + '&body=' + encodeURIComponent(emailBody), '_blank');

  if (formStatus) {
    formStatus.textContent = '✅ Se abrirán WhatsApp y tu correo. ¡Gracias por registrarte!';
    formStatus.classList.remove('hidden', 'bg-red-600/20', 'border-red-600');
    formStatus.classList.add('bg-green-600/20', 'border', 'border-green-600', 'text-green-200');
    setTimeout(function() { 
      formStatus.classList.add('hidden');
      // Opcional: resetear formulario después del envío
      const form = document.getElementById('playerForm');
      if (form && form.reset) form.reset();
      // Restablecer selector de país a México
      if (selectedCountryDisplay) {
        selectedCountryDisplay.innerHTML = '<span class="fi fi-mx w-5 h-5"></span><span>México</span>';
      }
      if (countryValueHidden) countryValueHidden.value = '';
      if (customSelectDropdown) customSelectDropdown.classList.add('hidden');
    }, 6000);
  }
}

// ----- Inicialización -----
function initForm() {
  // Construir dropdown de países
  function buildDropdown() {
    if (!customSelectDropdown) return;
    const container = customSelectDropdown.querySelector('div');
    if (!container) return;
    container.innerHTML = '';
    paises.forEach(function(pais) {
      const optionDiv = document.createElement('div');
      optionDiv.className = 'flex items-center gap-2 px-4 py-2 hover:bg-dorado/20 cursor-pointer transition-colors rounded';
      optionDiv.innerHTML = '<span class="' + pais.flag + ' w-5 h-5"></span><span>' + pais.nombre + '</span>';
      optionDiv.addEventListener('click', function() {
        if (selectedCountryDisplay) {
          selectedCountryDisplay.innerHTML = '<span class="' + pais.flag + ' w-5 h-5"></span><span>' + pais.nombre + '</span>';
        }
        if (countryValueHidden) countryValueHidden.value = pais.nombre;
        if (customSelectDropdown) customSelectDropdown.classList.add('hidden');
      });
      container.appendChild(optionDiv);
    });
  }

  if (customSelectBtn && customSelectDropdown && customSelectContainer) {
    customSelectBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      customSelectDropdown.classList.toggle('hidden');
    });
    document.addEventListener('click', function(e) {
      if (customSelectContainer && !customSelectContainer.contains(e.target)) {
        if (customSelectDropdown) customSelectDropdown.classList.add('hidden');
      }
    });
  }
  buildDropdown();

  // Acción principal: enviar formulario
  if (actionBtn) actionBtn.addEventListener('click', submitFinal);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initForm);
} else {
  initForm();
}
</script>