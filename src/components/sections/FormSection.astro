  { iso: "sv", nombre: "El Salvador", flag: "fi fi-sv" },
  { iso: "sk", nombre: "Eslovaquia", flag: "fi fi-sk" },
  { iso: "si", nombre: "Eslovenia", flag: "fi fi-si" },
  { iso: "es", nombre: "España", flag: "fi fi-es" },
