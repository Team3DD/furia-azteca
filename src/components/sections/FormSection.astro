---
// src/components/sections/FormSection.astro
---

<section id="formulario" class="py-24 bg-carbon-mid text-crema" style="scroll-margin-top: 100px;">
  <div class="max-w-5xl mx-auto px-6 md:px-10">
    <div class="text-center mb-12">
      <span class="section-label text-dorado">Convocatoria abierta</span>
      <h2 class="font-display text-4xl md:text-5xl uppercase mt-2">¿Tienes lo que se necesita?</h2>
      <div class="h-1 w-20 bg-dorado mx-auto mt-4"></div>
      <p class="mt-6 text-crema/70 max-w-2xl mx-auto">
        Completa el formulario y forma parte de la selección de aficionados.
      </p>
    </div>

    <form id="playerForm" class="space-y-8">
      <!-- Tipo de jugador con bandera vectorial (no emoji) -->
      <div class="grid md:grid-cols-2 gap-6">
        <label class="flex items-center gap-3 p-4 bg-carbon/50 border border-crema/10 rounded-lg cursor-pointer hover:border-dorado transition-colors">
          <input type="radio" name="playerType" value="mexicano" checked class="w-5 h-5 accent-dorado">
          <span class="font-display uppercase tracking-wide flex items-center gap-2">
            <span class="fi fi-mx w-5 h-5"></span> Jugador mexicano
          </span>
        </label>
        <label class="flex items-center gap-3 p-4 bg-carbon/50 border border-crema/10 rounded-lg cursor-pointer hover:border-dorado transition-colors">
          <input type="radio" name="playerType" value="internacional" class="w-5 h-5 accent-dorado">
          <span class="font-display uppercase tracking-wide flex items-center gap-2">
            🌍 Jugador internacional
          </span>
        </label>
      </div>

      <!-- Selector de países personalizado (con banderas reales) -->
      <div id="countryGroup" class="hidden">
        <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">País de origen</label>
        
        <input type="hidden" id="countryValue" name="countryValue" value="">

        <!-- Select personalizado -->
        <div class="relative" id="customSelectContainer">
          <button type="button" id="customSelectBtn" class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema text-left flex items-center justify-between focus:outline-none focus:border-dorado transition-colors">
            <span id="selectedCountryDisplay" class="flex items-center gap-2">
              <span class="fi fi-mx w-5 h-5"></span>
              <span>México</span>
            </span>
            <svg class="w-4 h-4 text-crema/60 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="customSelectDropdown" class="absolute z-20 left-0 right-0 mt-1 bg-carbon-mid border border-crema/20 rounded-lg shadow-xl max-h-60 overflow-y-auto hidden">
            <div class="p-1 space-y-0.5"></div>
          </div>
        </div>
      </div>

      <!-- Campos personales -->
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">Nombre</label>
          <input type="text" id="firstName" required class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema focus:outline-none focus:border-dorado">
        </div>
        <div>
          <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">Apellido</label>
          <input type="text" id="lastName" required class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema focus:outline-none focus:border-dorado">
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">Teléfono (con código país)</label>
          <input type="tel" id="phone" required placeholder="+52 1234567890" class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema focus:outline-none focus:border-dorado">
        </div>
        <div>
          <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">Correo electrónico</label>
          <input type="email" id="email" required class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema focus:outline-none focus:border-dorado">
        </div>
      </div>

      <div id="formStatus" class="hidden p-4 rounded-lg text-center"></div>

      <div class="text-center pt-4">
        <button id="submitBtn" type="button" class="relative inline-flex items-center justify-center font-display font-medium uppercase tracking-wider whitespace-nowrap transition-all duration-150 outline-none focus-visible:ring-2 focus-visible:ring-dorado focus-visible:ring-offset-2 focus-visible:ring-offset-hueso dark:focus-visible:ring-offset-carbon rhomboid rhomboid-hover rhomboid-corners bg-gradient-to-tl from-amber-400 via-yellow-500 to-amber-300 text-carbon hover:from-amber-500 hover:via-yellow-600 hover:to-amber-400 text-base py-2.5 px-8">
          <span class="rhomboid-content">Enviar solicitud</span>
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  const WHATSAPP_NUMBER = '521234567890';
  const EMAIL_DESTINO = 'contacto@internationalfanscup.com';

  const paises = [
    { iso: "de", nombre: "Alemania", flag: "fi fi-de" },
    { iso: "sa", nombre: "Arabia Saudita", flag: "fi fi-sa" },
    { iso: "ar", nombre: "Argentina", flag: "fi fi-ar" },
    { iso: "au", nombre: "Australia", flag: "fi fi-au" },
    { iso: "be", nombre: "Bélgica", flag: "fi fi-be" },
    { iso: "ba", nombre: "Bosnia y Herzegovina", flag: "fi fi-ba" },
    { iso: "br", nombre: "Brasil", flag: "fi fi-br" },
    { iso: "ca", nombre: "Canadá", flag: "fi fi-ca" },
    { iso: "cv", nombre: "Cabo Verde", flag: "fi fi-cv" },
    { iso: "cm", nombre: "Camerún", flag: "fi fi-cm" },
    { iso: "qa", nombre: "Catar", flag: "fi fi-qa" },
    { iso: "cl", nombre: "Chile", flag: "fi fi-cl" },
    { iso: "co", nombre: "Colombia", flag: "fi fi-co" },
    { iso: "kr", nombre: "Corea del Sur", flag: "fi fi-kr" },
    { iso: "ci", nombre: "Costa de Marfil", flag: "fi fi-ci" },
    { iso: "cr", nombre: "Costa Rica", flag: "fi fi-cr" },
    { iso: "hr", nombre: "Croacia", flag: "fi fi-hr" },
    { iso: "cw", nombre: "Curazao", flag: "fi fi-cw" },
    { iso: "dk", nombre: "Dinamarca", flag: "fi fi-dk" },
    { iso: "ec", nombre: "Ecuador", flag: "fi fi-ec" },
    { iso: "eg", nombre: "Egipto", flag: "fi fi-eg" },
    { iso: "sv", nombre: "El Salvador", flag: "fi fi-sv" },
    { iso: "sk", nombre: "Eslovaquia", flag: "fi fi-sk" },
    { iso: "si", nombre: "Eslovenia", flag: "fi fi-si" },
    { iso: "es", nombre: "España", flag: "fi fi-es" },
    { iso: "us", nombre: "Estados Unidos", flag: "fi fi-us" },
    { iso: "fr", nombre: "Francia", flag: "fi fi-fr" },
    { iso: "gh", nombre: "Ghana", flag: "fi fi-gh" },
    { iso: "gt", nombre: "Guatemala", flag: "fi fi-gt" },
    { iso: "ht", nombre: "Haití", flag: "fi fi-ht" },
    { iso: "hn", nombre: "Honduras", flag: "fi fi-hn" },
    { iso: "gb", nombre: "Inglaterra", flag: "fi fi-gb" },
    { iso: "ir", nombre: "Irán", flag: "fi fi-ir" },
    { iso: "it", nombre: "Italia", flag: "fi fi-it" },
    { iso: "jp", nombre: "Japón", flag: "fi fi-jp" },
    { iso: "ma", nombre: "Marruecos", flag: "fi fi-ma" },
    { iso: "nz", nombre: "Nueva Zelanda", flag: "fi fi-nz" },
    { iso: "no", nombre: "Noruega", flag: "fi fi-no" },
    { iso: "nl", nombre: "Países Bajos", flag: "fi fi-nl" },
    { iso: "pa", nombre: "Panamá", flag: "fi fi-pa" },
    { iso: "py", nombre: "Paraguay", flag: "fi fi-py" },
    { iso: "pe", nombre: "Perú", flag: "fi fi-pe" },
    { iso: "pl", nombre: "Polonia", flag: "fi fi-pl" },
    { iso: "pt", nombre: "Portugal", flag: "fi fi-pt" },
    { iso: "cz", nombre: "República Checa", flag: "fi fi-cz" },
    { iso: "cd", nombre: "República Democrática del Congo", flag: "fi fi-cd" },
    { iso: "do", nombre: "República Dominicana", flag: "fi fi-do" },
    { iso: "sn", nombre: "Senegal", flag: "fi fi-sn" },
    { iso: "rs", nombre: "Serbia", flag: "fi fi-rs" },
    { iso: "za", nombre: "Sudáfrica", flag: "fi fi-za" },
    { iso: "se", nombre: "Suecia", flag: "fi fi-se" },
    { iso: "ch", nombre: "Suiza", flag: "fi fi-ch" },
    { iso: "tn", nombre: "Túnez", flag: "fi fi-tn" },
    { iso: "tr", nombre: "Turquía", flag: "fi fi-tr" },
    { iso: "ua", nombre: "Ucrania", flag: "fi fi-ua" },
    { iso: "uy", nombre: "Uruguay", flag: "fi fi-uy" },
    { iso: "uz", nombre: "Uzbekistán", flag: "fi fi-uz" },
    { iso: "ve", nombre: "Venezuela", flag: "fi fi-ve" }
  ];

  // Elementos DOM
  const radioMexicano = document.querySelector('input[value="mexicano"]') as HTMLInputElement | null;
  const radioInternacional = document.querySelector('input[value="internacional"]') as HTMLInputElement | null;
  const countryGroup = document.getElementById('countryGroup');
  const customSelectContainer = document.getElementById('customSelectContainer');
  const customSelectBtn = document.getElementById('customSelectBtn');
  const customSelectDropdown = document.getElementById('customSelectDropdown');
  const selectedCountryDisplay = document.getElementById('selectedCountryDisplay');
  const countryValueHidden = document.getElementById('countryValue') as HTMLInputElement | null;
  const submitBtn = document.getElementById('submitBtn');
  const formStatus = document.getElementById('formStatus');
  const firstNameInput = document.getElementById('firstName') as HTMLInputElement | null;
  const lastNameInput = document.getElementById('lastName') as HTMLInputElement | null;
  const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
  const emailInput = document.getElementById('email') as HTMLInputElement | null;

  // Mostrar/ocultar país
  if (radioMexicano && radioInternacional) {
    radioMexicano.addEventListener('change', () => {
      if (radioMexicano.checked && countryGroup) countryGroup.classList.add('hidden');
    });
    radioInternacional.addEventListener('change', () => {
      if (radioInternacional.checked && countryGroup) countryGroup.classList.remove('hidden');
    });
  }

  // Construir opciones del select personalizado
  function buildDropdown() {
    if (!customSelectDropdown) return;
    const container = customSelectDropdown.querySelector('div');
    if (!container) return;
    container.innerHTML = '';
    paises.forEach(pais => {
      const optionDiv = document.createElement('div');
      optionDiv.className = 'flex items-center gap-2 px-4 py-2 hover:bg-dorado/20 cursor-pointer transition-colors rounded';
      optionDiv.innerHTML = `<span class="${pais.flag} w-5 h-5"></span><span>${pais.nombre}</span>`;
      optionDiv.addEventListener('click', () => {
        if (selectedCountryDisplay) {
          selectedCountryDisplay.innerHTML = `<span class="${pais.flag} w-5 h-5"></span><span>${pais.nombre}</span>`;
        }
        if (countryValueHidden) countryValueHidden.value = pais.nombre;
        if (customSelectDropdown) customSelectDropdown.classList.add('hidden');
      });
      container.appendChild(optionDiv);
    });
  }

  // Alternar dropdown
  if (customSelectBtn && customSelectDropdown && customSelectContainer) {
    customSelectBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      customSelectDropdown.classList.toggle('hidden');
    });
    document.addEventListener('click', (e) => {
      if (!customSelectContainer.contains(e.target as Node)) {
        customSelectDropdown.classList.add('hidden');
      }
    });
  }

  buildDropdown();

  // Funciones
  function showMessage(text: string, isError = false) {
    if (!formStatus) return;
    formStatus.textContent = text;
    formStatus.classList.remove('hidden', 'bg-green-600/20', 'border-green-600', 'bg-red-600/20', 'border-red-600');
    if (isError) {
      formStatus.classList.add('bg-red-600/20', 'border', 'border-red-600', 'text-red-200');
    } else {
      formStatus.classList.add('bg-green-600/20', 'border', 'border-green-600', 'text-green-200');
    }
    setTimeout(() => formStatus.classList.add('hidden'), 5000);
  }

  submitBtn?.addEventListener('click', () => {
    const playerTypeRadio = document.querySelector('input[name="playerType"]:checked') as HTMLInputElement | null;
    const playerType = playerTypeRadio?.value;
    const firstName = firstNameInput?.value.trim() || '';
    const lastName = lastNameInput?.value.trim() || '';
    const phone = phoneInput?.value.trim() || '';
    const email = emailInput?.value.trim() || '';

    let country = '';
    if (playerType === 'internacional') {
      country = countryValueHidden?.value || '';
      if (!country) {
        showMessage('Por favor selecciona tu país de origen.', true);
        return;
      }
    } else {
      country = 'México';
    }

    if (!firstName || !lastName || !phone || !email) {
      showMessage('Todos los campos son obligatorios.', true);
      return;
    }
    if (!email.includes('@')) {
      showMessage('Correo electrónico no válido.', true);
      return;
    }

    // WhatsApp
    const message = `Nuevo registro International Fans Cup%0A%0A` +
      `*Tipo:* ${playerType === 'mexicano' ? 'Mexicano' : 'Internacional'}%0A` +
      `*Nombre:* ${firstName} ${lastName}%0A` +
      `*País:* ${country}%0A` +
      `*Teléfono:* ${phone}%0A` +
      `*Email:* ${email}`;
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${message}`, '_blank');

    // Correo
    const subject = encodeURIComponent(`Registro IFC - ${firstName} ${lastName}`);
    const body = encodeURIComponent(
      `Nuevo registro\n\n` +
      `Tipo: ${playerType === 'mexicano' ? 'Mexicano' : 'Internacional'}\n` +
      `Nombre: ${firstName} ${lastName}\n` +
      `País: ${country}\n` +
      `Teléfono: ${phone}\n` +
      `Email: ${email}`
    );
    window.open(`mailto:${EMAIL_DESTINO}?subject=${subject}&body=${body}`, '_blank');

    showMessage('✅ Se abrirán WhatsApp y tu correo. ¡Gracias por registrarte!');

    // Reset formulario
    const form = document.getElementById('playerForm') as HTMLFormElement | null;
    form?.reset();
    if (countryGroup) countryGroup.classList.add('hidden');
    if (radioMexicano) radioMexicano.checked = true;
    if (selectedCountryDisplay) {
      selectedCountryDisplay.innerHTML = `<span class="fi fi-mx w-5 h-5"></span><span>México</span>`;
    }
    if (countryValueHidden) countryValueHidden.value = '';
    if (customSelectDropdown) customSelectDropdown.classList.add('hidden');
  });
</script>