---
// src/components/sections/FormSection.astro
---

<section id="formulario" class="py-24 bg-carbon-mid text-crema" style="scroll-margin-top: 100px;">
  <div class="max-w-5xl mx-auto px-6 md:px-10">
    <div class="text-center mb-12">
      <span class="section-label text-dorado">Convocatoria abierta</span>
      <h2 class="font-display text-4xl md:text-5xl uppercase mt-2">Inscribir a mi Equipo</h2>
      <div class="h-1 w-20 bg-dorado mx-auto mt-4"></div>
      <p class="mt-6 text-crema/70 max-w-2xl mx-auto">
        Complete este formulario para participar en el torneo
      </p>
    </div>

    <form id="playerForm" class="space-y-8">
      <!-- Selector de países (siempre visible) -->
      <div id="countryGroup">
        <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">País de origen / Nation Confirmed</label>
        <input type="hidden" id="countryValue" name="countryValue" value="">
        <div class="relative" id="customSelectContainer">
          <button type="button" id="customSelectBtn" class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema text-left flex items-center justify-between focus:outline-none focus:border-dorado transition-colors">
            <span id="selectedCountryDisplay" class="flex items-center gap-2">
              <span class="fi fi-mx w-5 h-5"></span>
              <span>México</span>
            </span>
            <svg class="w-4 h-4 text-crema/60 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="customSelectDropdown" class="absolute z-20 left-0 right-0 mt-1 bg-carbon-mid border border-crema/20 rounded-lg shadow-xl max-h-60 overflow-y-auto hidden">
            <div class="p-1 space-y-0.5"></div>
          </div>
        </div>
      </div>

      <!-- Campos personales con efecto romboidal en los inputs -->
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">Nombre / First Name</label>
          <div class="md:rhomboid md:rhomboid-corners transition-all duration-150">
            <input type="text" id="firstName" required class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema focus:outline-none focus:border-dorado md:rhomboid-content transition-all duration-150">
          </div>
        </div>
        <div>
          <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">Apellido / Last Name</label>
          <div class="md:rhomboid md:rhomboid-corners transition-all duration-150">
            <input type="text" id="lastName" required class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema focus:outline-none focus:border-dorado md:rhomboid-content transition-all duration-150">
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">Teléfono / Phone</label>
          <div class="md:rhomboid md:rhomboid-corners transition-all duration-150">
            <input type="tel" id="phone" required placeholder="+52 15527574349" class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema focus:outline-none focus:border-dorado md:rhomboid-content transition-all duration-150">
          </div>
        </div>
        <div>
          <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">E-mail</label>
          <div class="md:rhomboid md:rhomboid-corners transition-all duration-150">
            <input type="email" id="email" required class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema focus:outline-none focus:border-dorado md:rhomboid-content transition-all duration-150">
          </div>
        </div>
      </div>

      <!-- Campos opcionales: Instagram y Facebook -->
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">Instagram:</label>
          <div class="md:rhomboid md:rhomboid-corners transition-all duration-150">
            <input type="text" id="instagram" name="instagram" placeholder="personal / equipo" class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema focus:outline-none focus:border-dorado md:rhomboid-content transition-all duration-150">
          </div>
        </div>
        <div>
          <label class="block font-body text-sm uppercase tracking-wider text-dorado mb-2">Facebook:</label>
          <div class="md:rhomboid md:rhomboid-corners transition-all duration-150">
            <input type="text" id="facebook" name="facebook" placeholder="personal / equipo" class="w-full bg-carbon border border-crema/20 rounded-lg px-4 py-3 text-crema focus:outline-none focus:border-dorado md:rhomboid-content transition-all duration-150">
          </div>
        </div>
      </div>

      <!-- ========= SECCIÓN DE JUGADORES COMENTADA ========= 
      <div id="playersSection" class="hidden space-y-4">
        <div class="border-t border-crema/20 pt-4">
          <h3 class="font-display text-2xl uppercase text-dorado text-center mb-4">Lista de jugadores / Player List</h3>
          <p class="text-sm text-crema/60 text-center mb-6">Mínimo 7 jugadores - Máximo 20 / Minimum 7 Players - Maximum 20</p>
          <div id="playersContainer" class="space-y-4 max-h-96 overflow-y-auto pr-2"></div>
          <div class="flex flex-wrap gap-4 justify-center mt-6">
            <button type="button" id="addPlayerBtn" class="px-4 py-2 text-sm font-body uppercase tracking-wider border border-dorado text-dorado rounded-lg hover:bg-dorado/10 transition">+ Agregar jugador</button>
            <button type="button" id="removeLastPlayerBtn" class="px-4 py-2 text-sm font-body uppercase tracking-wider border border-red-500 text-red-400 rounded-lg hover:bg-red-500/10 transition">- Quitar último</button>
          </div>
        </div>
      </div>
      ================================================ -->

      <div id="formStatus" class="hidden p-4 rounded-lg text-center"></div>

      <div class="text-center pt-4">
        <button id="actionBtn" type="button" class="relative inline-flex items-center justify-center font-display font-medium uppercase tracking-wider whitespace-nowrap transition-all duration-150 outline-none focus-visible:ring-2 focus-visible:ring-dorado focus-visible:ring-offset-2 focus-visible:ring-offset-hueso dark:focus-visible:ring-offset-carbon rhomboid rhomboid-hover rhomboid-corners bg-gradient-to-tl from-amber-400 via-yellow-500 to-amber-300 text-carbon hover:from-amber-500 hover:via-yellow-600 hover:to-amber-400 text-base py-2.5 px-8">
          <span class="rhomboid-content">Enviar</span>
        </button>
      </div>
    </form>
  </div>
</section>

<!-- Modal personalizado -->
<div id="customModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm transition-all">
  <div class="bg-carbon-mid border border-dorado/30 rounded-xl max-w-md w-full mx-4 p-6 shadow-2xl">
    <h3 id="modalTitle" class="font-display text-2xl text-dorado mb-3">Atención</h3>
    <p id="modalMessage" class="text-crema/90 mb-6"></p>
    <div class="flex justify-end">
      <button id="closeModalBtn" class="px-5 py-2 bg-dorado text-carbon font-bold rounded-lg hover:bg-amber-500 transition">Cerrar</button>
    </div>
  </div>
</div>

<style>
  /* Al hacer focus en el input, eliminamos la inclinación romboidal */
  input:focus {
    transform: skewX(0deg) !important;
  }
  /* También aseguramos que el contenedor padre no interfiera */
  input:focus ~ *,
  input:focus {
    transition: transform 150ms ease;
  }
</style>

<script>
// @ts-nocheck
// ----- CONSTANTES (cámbialas por las tuyas) -----
const WHATSAPP_NUMBER = '5215527574349';
const EMAIL_DESTINO = 'contacto@internationalfanscup.com';

// ----- LISTA DE PAÍSES (completa) -----
const paises = [
  { iso: "mx", nombre: "México", flag: "fi fi-mx" },
