  { iso: "ch", nombre: "Suiza", flag: "fi fi-ch" },
  { iso: "tn", nombre: "Túnez", flag: "fi fi-tn" },
  { iso: "tr", nombre: "Turquía", flag: "fi fi-tr" },
  { iso: "ua", nombre: "Ucrania", flag: "fi fi-ua" },
  { iso: "uy", nombre: "Uruguay", flag: "fi fi-uy" },
  { iso: "uz", nombre: "Uzbekistán", flag: "fi fi-uz" },
  { iso: "ve", nombre: "Venezuela", flag: "fi fi-ve" }
