---
// src/components/sections/Sponsors.astro

// Define cada sponsor con su imagen y enlace (cambia las URLs por las reales)
const sponsors = [
  { img: "images/sponsors/sponsor1.png", link: "" },
  { img: "images/sponsors/sponsor2.png", link: "" },
  { img: "images/sponsors/sponsor3.png", link: "https://www.instagram.com/socorrotequila?igsh=MmU3NGlybnlzd2Qw" },
  { img: "images/sponsors/sponsor4.png", link: "" },
  { img: "images/sponsors/sponsor5.png", link: "" },
  { img: "images/sponsors/sponsor6.png", link: "" },
  { img: "images/sponsors/sponsor7.png", link: "https://www.instagram.com/hospitalcovadongaver?igsh=NTY0YXZpYnV5OW95" },
  { img: "images/sponsors/sponsor8.png", link: "https://www.instagram.com/bryanb.clutch?utm_source=qr" },
];
---

<section id="sponsors" class="bg-carbon py-16 overflow-hidden">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10">
      <span class="section-label">PATROCINADORES</span>
      <h2 class="font-display text-4xl md:text-5xl text-white uppercase mt-4">
        Aliados que nos apoyan
      </h2>
    </div>

    <div class="relative overflow-hidden">
      <div class="sponsors-track">
        {[...sponsors, ...sponsors].map((sponsor) => (
          <a
            href={sponsor.link}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-shrink-0 hover:opacity-80 transition-opacity duration-300"
          >
            <img
              src={sponsor.img}
              alt="Sponsor"
              class="h-[100px] w-auto object-contain"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .sponsors-track {
    display: flex;
    align-items: center;
    gap: 50px;
    width: max-content;
    animation: sponsors-scroll 30s linear infinite;
  }

  @keyframes sponsors-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .sponsors-track:hover {
    animation-play-state: paused;
  }
</style>