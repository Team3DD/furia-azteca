---
// src/components/sections/CTAUnete.astro
import { Button } from "../ui/button";
---

<section class="relative overflow-hidden bg-carbon py-24" aria-labelledby="cta-title">
  <div class="absolute inset-0 bg-gradient-azteca opacity-80" aria-hidden="true"></div>
  
  <!-- Bordes laterales con degradado vertical delgado -->
  <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-transparent via-dorado to-transparent" aria-hidden="true"></div>
  <div class="absolute right-0 top-0 bottom-0 w-1 bg-gradient-to-b from-transparent via-dorado to-transparent" aria-hidden="true"></div>

  <div class="relative max-w-4xl mx-auto px-6 text-center">
    <p class="section-label mb-4">¿Listo para el IFC 2026?</p>
    <h2 id="cta-title" class="font-display text-white text-4xl md:text-6xl uppercase leading-none mb-6">
      Únete al<br/>
      <span class="text-dorado">movimiento</span>
    </h2>
    <p class="font-body text-white/60 text-lg max-w-xl mx-auto mb-10 leading-relaxed">
      Jugadores, aficionados, voluntarios y líderes locales. Hay un lugar para ti en la Selección Mexicana de Aficionados.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href="/#formulario" variant="solid" color="dorado" size="lg">
        Quiero participar
      </Button>
      <Button 
        href="/#formulario" 
        variant="outline" 
        color="dorado" 
        size="lg" 
        className="!border-white/30 !text-white hover:!bg-white hover:!text-carbon"
      >
        Tengo preguntas
      </Button>
    </div>
  </div>
</section>