---
const hitos = [
  {
    year: '2017',
    title: 'El origen',
    description: 'Nace la idea de llevar una selección organizada de aficionados mexicanos a un Mundial. Un grupo de apasionados decide que la afición merece representación.',
    accent: 'bg-dorado',
  },
  {
    year: '2018',
    title: 'Rusia — La primera vez',
    description: 'Primera participación oficial en Copa del Mundo. El movimiento debuta ante el mundo y sienta las bases de lo que vendría.',
    accent: 'bg-rojo',
  },
  {
    year: '2019–21',
    title: 'Crecimiento interno',
    description: 'Consolidación de sedes, formación de líderes regionales y construcción de comunidad. La pandemia no detiene el proyecto.',
    accent: 'bg-dorado',
  },
  {
    year: '2022',
    title: 'Qatar — El mejor torneo de fans',
    description: 'Furia Azteca participa en la International Fans Cup y es reconocida como el mejor torneo de aficionados de Qatar 2022. Participación varonil y femenil.',
    accent: 'bg-verde',
  },
  {
    year: '2026',
    title: 'La gran cita en casa',
    description: 'El movimiento se prepara para México, Estados Unidos y Canadá. La edición más ambiciosa, en tierra propia.',
    accent: 'bg-dorado',
  },
];
---

<section class="py-24 bg-carbon overflow-hidden" aria-labelledby="historia-preview-title">
  <div class="absolute left-0 w-1 h-64 bg-gradient-to-b from-transparent via-dorado to-transparent" aria-hidden="true"></div>
  <div class="max-w-7xl mx-auto px-6">

    <div class="grid lg:grid-cols-2 gap-12 items-end mb-16">
      <div>
        <p class="section-label mb-3">Nuestra historia</p>
        <h2 id="historia-preview-title" class="font-display text-white text-4xl md:text-5xl uppercase leading-none">
          De una idea<br/>
          <span class="text-dorado">a dos mundiales.</span>
        </h2>
      </div>
      <div>
        <p class="font-body text-white/40 text-base leading-relaxed">
          Furia Azteca nació del convencimiento de que la afición mexicana merece más que las gradas.
          Somos jugadores, voluntarios, líderes y apasionados que llevan los colores de México
          a los escenarios más grandes del mundo.
        </p>
        <a
          href="/historia"
          class="inline-flex items-center gap-2 text-dorado font-display text-sm uppercase tracking-widest mt-5 hover:gap-4 transition-all group"
        >
          Historia completa
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>

    <div class="relative">
      <div
        class="hidden lg:block absolute left-[calc(50%-1px)] top-0 bottom-0 w-px bg-white/10"
        aria-hidden="true"
      ></div>

      <div class="space-y-0">
        {hitos.map(({ year, title, description, accent }, i) => {
          const isEven = i % 2 === 0;
          return (
            <div class:list={['relative grid lg:grid-cols-2 gap-0 group']}>

              <div
                class="hidden lg:flex absolute left-1/2 top-8 -translate-x-1/2 z-10 items-center justify-center"
                aria-hidden="true"
              >
                <div class:list={['w-3 h-3 border-2 border-carbon transition-all duration-300 group-hover:scale-150', accent]}></div>
              </div>

              <div class:list={[
                'lg:py-10 py-6',
                isEven ? 'lg:pr-16 lg:text-right' : 'lg:col-start-2 lg:pl-16',
              ]}>
                <div class:list={[
                  'inline-flex flex-col',
                  isEven ? 'lg:items-end' : 'lg:items-start',
                ]}>
                  <span class="font-display text-5xl md:text-6xl leading-none mb-3 text-white/10 group-hover:text-white/20 transition-colors duration-300">
                    {year}
                  </span>
                  <div class="border border-white/10 bg-white/[0.03] group-hover:bg-white/[0.06] group-hover:border-white/20 transition-all p-5 max-w-sm">
                    <div class:list={['w-6 h-[2px] mb-3', accent]}></div>
                    <h3 class="font-display text-white text-base uppercase tracking-wide leading-tight mb-2">
                      {title}
                    </h3>
                    <p class="font-body text-white/40 text-sm leading-relaxed">
                      {description}
                    </p>
                  </div>
                </div>
              </div>

              {isEven && <div class="hidden lg:block"></div>}

            </div>
          );
        })}
      </div>
    </div>

    <div class="mt-16 flex flex-col sm:flex-row items-center justify-center gap-4 border-t border-white/10 pt-12">
      <a href="/historia" class="btn-secondary border-white/20 text-white hover:bg-white hover:text-carbon">
        Leer historia completa
      </a>
      <a href="/mundiales/qatar-2022" class="btn-gold">
        Ver Qatar 2022 →
      </a>
    </div>

  </div>
</section>