---
// src/components/sections/HistoriaPreview.astro
import { Button } from "../ui/button";

const hitos = [
  {
    year: '2017',
    title: 'El origen',
    description: 'Nace la idea de participar en un torneo de fans 9 a side en Rusia 2017 invitación de la AMTEUR LEAGUE de Moscú nuestros Founders Gerardo Giacoman y Federico Buhrend entre otros crean la primer selección de fans.',
    accent: 'bg-dorado',
  },
  {
    year: '2018',
    title: 'Rusia La primera vez',
    description: 'Primer torneo de fans en el que nos presentamos como Furia Azteca y con mucho orgullo representamos los colores de nuestro país vs fans de diferentes partes del mundo - torneo organizado por la Amateur league de Moscú  quedamos.',
    accent: 'bg-rojo',
  },
  {
    year: '2019–21',
    title: 'Crecimiento interno',
    description: 'Consolidamos el crecimiento del proyecto en varias sedes y equipos representativos de Furia azteca  TIJUANA - CDMX - SAN DIEGO - FEMENIL  y MIXTO - MASTERS 45+ así como centros operativos en CDMX, Tijuana y Monterrey.',
    accent: 'bg-dorado',
  },
  {
    year: '2022',
    title: 'Qatar el inicio de la International Fans Cup',
    description: 'El primer Torneo Organizado enteramente por nosotros en Instalaciones deportivas de primer nivel, con la participación por primera vez de un equipo Femenil Completo que disputó el primer encuentro Femenil de Fans Mex v Arg haciendo historia, mientras que el torneo Varonil tuvo la participación de más de  Paises 🇲🇽🇪🇨🇭🇷🇧🇷🇦🇷🇵🇹🇮🇳 entre otros Nace INTERNATIONAL FANS CUP',
    accent: 'bg-verde',
  },
  {
    year: '2026',
    title: 'La gran cita en casa',
    description: 'Este 2026 nos espera con un gran torneo que tendra cobertura mediatica aliados y amigos promoviendo el deporte más hermoso del mundo, estamos muy orgullosos de ser anfitriones.',
    accent: 'bg-dorado',
  },
];
---

<section id="historia" class="py-24 bg-carbon overflow-hidden" aria-labelledby="historia-preview-title">
  <div class="absolute left-0 w-1 h-64 bg-gradient-to-b from-transparent via-dorado to-transparent" aria-hidden="true"></div>
  <div class="max-w-7xl mx-auto px-6">

    <div class="grid lg:grid-cols-2 gap-12 items-end mb-16">
      <div>
        <p class="section-label mb-3">Nuestra historia</p>
        <h2 id="historia-preview-title" class="font-display text-white text-4xl md:text-5xl uppercase leading-none">
          De una idea<br/>
          <span class="text-dorado">a dos mundiales.</span>
        </h2>
      </div>
      <div>
        <p class="font-body text-white/40 text-base leading-relaxed">
          Furia Azteca nació del convencimiento de que la afición mexicana merece más que las gradas.
          Somos jugadores, voluntarios, líderes y apasionados que llevan los colores de México
          a los escenarios más grandes del mundo.
        </p>
        
          href="/#formulario"
          class="inline-flex items-center gap-2 text-dorado font-display text-sm uppercase tracking-widest mt-5 hover:gap-4 transition-all group"
        >
          Historia completa
        </a>
      </div>
    </div>

    <div class="relative">
      <div class="hidden lg:block absolute left-[calc(50%-1px)] top-0 bottom-0 w-px bg-white/10" aria-hidden="true"></div>

      <div class="flex flex-col gap-12 md:gap-0">
        {hitos.map(({ year, title, description, accent }, i) => {
          const isEven = i % 2 === 0;
          return (
            <div class="relative grid lg:grid-cols-2 gap-6 md:gap-0 group">
              <div class="hidden lg:flex absolute left-1/2 top-8 -translate-x-1/2 z-10 items-center justify-center" aria-hidden="true">
                <div class={['w-3 h-3 border-2 border-carbon transition-all duration-300 group-hover:scale-150', accent].join(' ')}></div>
              </div>

              <div class={[
                'py-4 md:py-10',
                isEven ? 'lg:pr-16 lg:text-right' : 'lg:col-start-2 lg:pl-16',
              ].join(' ')}>
                <div class={[
                  'flex flex-col',
                  isEven ? 'lg:items-end' : 'lg:items-start',
                  'items-center',
                ].join(' ')}>
                  <span class="font-display text-5xl md:text-6xl leading-none mb-3 text-white/10 group-hover:text-white/20 transition-colors duration-300">
                    {year}
                  </span>

                  <div class="w-full max-w-sm mx-auto md:mx-0">
                    <!-- CARD: en mobile es un acordeón, en desktop mantiene hover -->
                    <div data-tilt class="hito-card rounded-lg border border-white/10 bg-white/[0.03] overflow-hidden">

                      <!-- CABECERA: siempre visible, en mobile es clickeable -->
                      <button
                        class="hito-trigger w-full flex flex-col items-center justify-center p-5 text-center md:hidden"
                        aria-expanded="false"
                      >
                        <div class={['w-6 h-[2px] mb-3', accent].join(' ')}></div>
                        <h3 class="font-display text-white text-base uppercase tracking-wide leading-tight">
                          {title}
                        </h3>
                        <span class="text-white/30 text-xs mt-2 accordion-hint">toca para ver más ↓</span>
                      </button>

                      <!-- Título en desktop (no clickeable) -->
                      <div class="hidden md:flex relative h-64 flex-col items-center justify-center p-5 text-center group/card overflow-hidden">
                        <div class="transition-transform duration-300 ease-out group-hover/card:-translate-y-12 flex flex-col items-center">
                          <div class={['w-6 h-[2px] mb-3 transition-colors duration-300 group-hover/card:bg-carbon', accent].join(' ')}></div>
                          <h3 class="font-display text-white text-base uppercase tracking-wide leading-tight transition-colors duration-300 group-hover/card:text-carbon">
                            {title}
                          </h3>
                        </div>
                        <!-- Cortina dorada desktop -->
                        <div class="absolute inset-0 bg-dorado text-carbon p-5 flex items-center justify-center transition-transform duration-300 ease-out -translate-y-full group-hover/card:translate-y-0">
                          <p class="font-body text-sm leading-relaxed text-center">{description}</p>
                        </div>
                      </div>

                      <!-- Descripción mobile (acordeón) -->
                      <div class="hito-body md:hidden overflow-hidden max-h-0 transition-all duration-500 ease-in-out">
                        <div class="bg-dorado text-carbon p-5">
                          <p class="font-body text-sm leading-relaxed text-center">{description}</p>
                        </div>
                      </div>

                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <div class="mt-16 flex flex-col sm:flex-row items-center justify-center gap-4 border-t border-white/10 pt-12">
      <Button href="/#formulario" variant="outline" color="verde" size="lg" className="!border-white/20 !text-white hover:!bg-white hover:!text-carbon">
        Leer historia completa
      </Button>
      <Button href="/#formulario" variant="solid" color="dorado" size="lg">
        Quiero unirme al movimiento
      </Button>
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {

    // ── ACORDEÓN MOBILE ──────────────────────────────────────────
    document.querySelectorAll('.hito-trigger').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        const card = trigger.closest('.hito-card');
        const body = card.querySelector('.hito-body');
        const hint = trigger.querySelector('.accordion-hint');
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          body.style.maxHeight = '0px';
          trigger.setAttribute('aria-expanded', 'false');
          hint.textContent = 'toca para ver más ↓';
        } else {
          body.style.maxHeight = body.scrollHeight + 'px';
          trigger.setAttribute('aria-expanded', 'true');
          hint.textContent = 'cerrar ↑';
        }
      });
    });

    // ── TILT AL SCROLL (desktop) ─────────────────────────────────
    const cards = document.querySelectorAll('[data-tilt]');

    cards.forEach(function (card) {
      card.style.opacity = '0';
      card.style.transform = 'perspective(800px) rotateY(-8deg) rotateX(4deg)';
      card.style.transition = 'transform 0.7s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.6s ease';
    });

    const observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.style.transform = 'perspective(800px) rotateY(0deg) rotateX(0deg)';
          entry.target.style.opacity = '1';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

    cards.forEach(function (card) {
      observer.observe(card);

      card.addEventListener('mousemove', function (e) {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = 'perspective(800px) rotateY(' + (x * 12) + 'deg) rotateX(' + (-y * 8) + 'deg)';
      });

      card.addEventListener('mouseleave', function () {
        card.style.transform = 'perspective(800px) rotateY(0deg) rotateX(0deg)';
      });
    });

  });
</script>