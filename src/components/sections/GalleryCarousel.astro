  { num: "02", badge: "Debut",         alt: "Primer partido del Tri en Qatar" },
  { num: "03", badge: "Afición",       alt: "La marea verde en Lusail" },
  { num: "04", badge: "Clásico",       alt: "México vs Argentina" },
  { num: "05", badge: "Gol",           alt: "Festejo de gol tricolor" },
  { num: "06", badge: "Tata",          alt: "DT Martino da instrucciones" },
  { num: "07", badge: "Polonia",       alt: "México vs Polonia, empate" },
  { num: "08", badge: "Arabia",        alt: "México vs Arabia Saudita" },
  { num: "09", badge: "Ochoa",         alt: "Guillermo Ochoa para el penal" },
  { num: "10", badge: "Lusail",        alt: "Estadio Lusail, Qatar" },
  { num: "11", badge: "Ensayo",        alt: "Entrenamiento en Qatar" },
  { num: "12", badge: "Verde",         alt: "Mosaico de aficionados" },
  { num: "13", badge: "Liderazgo",     alt: "Héctor Herrera lidera" },
  { num: "14", badge: "Bloque bajo",   alt: "Defensa compacta" },
  { num: "15", badge: "Velocidad",     alt: "Antuna por la banda" },
  { num: "16", badge: "Intensidad",    alt: "Duelo en mediocampo" },
  { num: "17", badge: "Desierto",      alt: "Atardecer en Qatar" },
  { num: "18", badge: "Unión",         alt: "El Tri junto antes del partido" },
  { num: "19", badge: "Último juego",  alt: "Final del ciclo mundialista" },
  { num: "20", badge: "Hasta Qatar",   alt: "Despedida del Tri en Qatar 2022" },
