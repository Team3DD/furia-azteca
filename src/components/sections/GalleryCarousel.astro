  { num: "04", badge: "Fase Grupos",   alt: "México vs Corea del Sur" },
  { num: "05", badge: "Victoria",      alt: "Celebración del Tri" },
  { num: "06", badge: "El Piojo",      alt: "DT Osorio en la cancha" },
  { num: "07", badge: "Octavos",       alt: "México vs Brasil, octavos" },
  { num: "08", badge: "Rivalidad",     alt: "México vs Suecia" },
  { num: "09", badge: "Portero",       alt: "Ochoa en acción" },
  { num: "10", badge: "Estadio",       alt: "Luzhniki Stadium" },
  { num: "11", badge: "Arranque",      alt: "Calentamiento pre-partido" },
  { num: "12", badge: "Pasión",        alt: "Marea verde en las tribunas" },
  { num: "13", badge: "Capitán",       alt: "Andrés Guardado lidera al Tri" },
  { num: "14", badge: "Defensa",       alt: "Línea defensiva mexicana" },
  { num: "15", badge: "Velocidad",     alt: "Lozano desborda por banda" },
