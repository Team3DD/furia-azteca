---
// src/components/sections/GalleryCarousel.astro
// Badge con rhomboid-corners-only, sin CTA, línea divisoria con gradiente, cards grandes.
// Soporta imágenes y vídeos desde la carpeta "furia". Placeholder para vídeos rotos.

interface MediaData {
  num: string;
  badge: string;
  alt: string;
  type: "image" | "video";
}

// ========== DATOS DE EJEMPLO (cámbialos según tu contenido real) ==========
const furiaData: MediaData[] = [
  { num: "01", badge: "Inicio",        alt: "Furia Azteca presentación", type: "image" },
  { num: "02", badge: "Pasión",        alt: "Afición cantando",           type: "video" },
  { num: "03", badge: "Equipo",        alt: "Foto grupal",                 type: "image" },
  { num: "04", badge: "Gol",           alt: "Celebración de gol",          type: "video" },
  { num: "05", badge: "Viaje",         alt: "Llegada a la sede",           type: "image" },
  { num: "06", badge: "Entrenamiento", alt: "Práctica previa",             type: "image" },
  { num: "07", badge: "Afición",       alt: "Marea verde en las gradas",   type: "video" },
];

const galerias = [
  {
    uid:       "gc-furia",
    titulo:    "Furia Azteca",
    carpeta:   "furia",
    data:      furiaData,
    direction: "fwd",
    speed:     80,
  },
];
// ========== FIN DE DATOS ==========

// Función para obtener la ruta del medio
const getMediaSrc = (num: string, type: "image" | "video") => {
  const extension = type === "image" ? "webp" : "mp4";
  return `/images/galeria/furia/furia${num}.${extension}`;
};

// Placeholder universal para vídeos (debe existir en /public/video.mp4)
const VIDEO_PLACEHOLDER = "/video.mp4";
---

<section class="bg-carbon w-full">
  {galerias.map(({ uid, titulo, data, direction, speed }, idx) => {
    const imagenes = [...data, ...data]; // duplicar para efecto infinito
    return (
      <>
        {idx > 0 && (
          <div class="w-full h-px bg-gradient-to-r from-transparent via-dorado to-transparent my-8" aria-hidden="true"></div>
        )}
        <div id={uid} class="relative py-12 overflow-hidden">
          <header class="relative z-10 text-center mb-12">
            <span class="section-label">Galería</span>
            <h2 class="section-title text-crema">{titulo}</h2>
          </header>

          <div class="relative z-10 gc-rows" data-direction={direction} style={`--speed: ${speed}s;`}>
            <div class="overflow-hidden py-4 mask-fade-horizontal">
              <div class="flex gap-10 w-max gc-track">
                {imagenes.map((media, i) => (
                  <button
                    class="gc-card rhomboid rhomboid-corners group"
                    type="button"
                    data-id={media.num}
                    data-src={getMediaSrc(media.num, media.type)}
                    data-alt={media.alt}
                    data-badge={media.badge}
                    data-type={media.type}
                    aria-label={media.alt}
                    tabindex={i < data.length ? "0" : "-1"}
                    aria-hidden={i >= data.length ? "true" : undefined}
                  >
                    {media.type === "image" ? (
                      <img
                        src={getMediaSrc(media.num, "image")}
                        alt={media.alt}
                        loading="lazy"
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-300"
                        onerror="this.onerror=null; this.src='/images/fallback.webp';"
                      />
                    ) : (
                      <video
                        src={getMediaSrc(media.num, "video")}
                        class="absolute inset-0 w-full h-full object-cover"
                        muted
                        loop
                        playsinline
                        autoplay
                        onerror="this.onerror=null; this.src='/video.mp4';"
                      ></video>
                    )}
                    <!-- Badge -->
                    <div class="absolute top-4 sm:top-6 left-4 sm:left-6 z-10">
                      <span class="rhomboid-corners-only inline-block font-display text-xs sm:text-sm uppercase tracking-widest bg-dorado text-carbon group-hover:bg-carbon group-hover:text-crema px-2 py-1 sm:px-3 sm:py-1 transition-all duration-200">
                        {media.badge}
                      </span>
                    </div>
                    <div class="absolute bottom-0 left-0 right-0 p-3 z-10 transition-transform duration-300 group-hover:translate-y-[-2px]">
                      <span class="block w-6 h-0.5 bg-dorado mb-2 transition-all duration-200 group-hover:w-8"></span>
                      <p class="font-display text-xs uppercase tracking-wide text-white drop-shadow-md line-clamp-2">{media.alt}</p>
                    </div>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </>
    );
  })}
</section>

<!-- Modal global mejorado (tamaño completo y placeholder) -->
<div id="global-modal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/90 backdrop-blur-md transition-all">
  <div class="relative w-full h-full flex items-center justify-center">
    <button id="modal-close" class="absolute top-4 right-4 z-10 text-dorado bg-black/50 hover:bg-black/70 rounded-full w-12 h-12 flex items-center justify-center text-3xl transition-all hover:rotate-90">✕</button>
    <button id="modal-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-10 bg-black/50 hover:bg-black/70 rounded-full w-12 h-12 flex items-center justify-center text-dorado text-4xl transition-all">‹</button>
    <button id="modal-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-10 bg-black/50 hover:bg-black/70 rounded-full w-12 h-12 flex items-center justify-center text-dorado text-4xl transition-all">›</button>
    
    <div id="modal-media-container" class="flex items-center justify-center w-full h-full p-4"></div>
    
    <p id="modal-counter" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-dorado text-sm tracking-[0.2em] font-mono bg-black/50 px-4 py-1 rounded-full">1 / 1</p>
  </div>
</div>

<style>
  /* Máscara de desvanecimiento */
  .mask-fade-horizontal {
    mask-image: linear-gradient(to right, transparent, black 7%, black 93%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 7%, black 93%, transparent);
  }
  /* Carrusel infinito */
  .gc-rows {
    --speed: 80s;
  }
  .gc-rows[data-direction="fwd"] .gc-track {
    animation: scrollFwd var(--speed) linear infinite;
  }
  .gc-rows[data-direction="rev"] .gc-track {
    animation: scrollRev var(--speed) linear infinite;
  }
  @keyframes scrollFwd {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-50% - 1.25rem)); }
  }
  @keyframes scrollRev {
    from { transform: translateX(calc(-50% - 1.25rem)); }
    to   { transform: translateX(0); }
  }
  .gc-rows:hover .gc-track,
  .gc-rows.dragging .gc-track {
    animation-play-state: paused;
  }
  /* Cards */
  .gc-card {
    position: relative;
    width: 500px;
    aspect-ratio: 4 / 3;
    cursor: pointer;
    overflow: hidden;
    background-color: #1a1f1c;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  @media (hover: hover) {
    .gc-card:hover {
      transform: skewX(0deg) scale(1.02);
      box-shadow: 0 20px 35px -12px rgba(0,0,0,0.5);
    }
  }
  .gc-card img,
  .gc-card video {
    transition: transform 0.3s ease;
  }
  .gc-card:hover img,
  .gc-card:hover video {
    transform: scale(1.03);
  }
  @media (max-width: 640px) {
    .gc-card {
      width: 300px;
    }
  }
  /* Línea divisoria */
  .bg-gradient-to-r {
    height: 2px;
  }
  /* Modal: contenido centrado y responsive */
  #global-modal {
    display: none;
  }
  #global-modal.flex {
    display: flex !important;
  }
  #modal-media-container img,
  #modal-media-container video {
    max-width: 90vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 1rem;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
  }
  #modal-media-container video {
    background: black;
  }
</style>

<script lang="js">
  (function() {
    // Arrastre (drag to scroll)
    document.querySelectorAll('.gc-rows').forEach(rows => {
      let isDragging = false;
      let startX = 0;
      let scrollLeft = 0;
      const wrap = rows.querySelector('.overflow-hidden');
      const track = rows.querySelector('.gc-track');
      if (!wrap || !track) return;

      const startDrag = (e) => {
        isDragging = true;
        rows.classList.add('dragging');
        const pageX = e.pageX ?? e.touches[0].pageX;
        startX = pageX - wrap.offsetLeft;
        scrollLeft = wrap.scrollLeft;
      };
      const onDrag = (e) => {
        if (!isDragging) return;
        e.preventDefault();
        const pageX = e.pageX ?? e.touches[0].pageX;
        const x = pageX - wrap.offsetLeft;
        const walk = (x - startX) * 1.5;
        wrap.scrollLeft = scrollLeft - walk;
      };
      const stopDrag = () => {
        isDragging = false;
        rows.classList.remove('dragging');
      };
      wrap.addEventListener('mousedown', startDrag);
      window.addEventListener('mousemove', onDrag);
      window.addEventListener('mouseup', stopDrag);
      wrap.addEventListener('touchstart', startDrag);
      window.addEventListener('touchmove', onDrag);
      window.addEventListener('touchend', stopDrag);
    });

    // Modal mejorado: soporta imágenes y vídeos
    const modal = document.getElementById('global-modal');
    const modalImg = document.getElementById('modal-img');
    const modalCounter = document.getElementById('modal-counter');
    const closeBtn = document.getElementById('modal-close');
    const prevBtn = document.getElementById('modal-prev');
    const nextBtn = document.getElementById('modal-next');

    let currentItems = [];     // { src, alt, type, id }
    let currentIndex = 0;
    let currentVideoElement = null; // para gestionar el vídeo dinámico

    // Función para limpiar y restaurar el modal a su estado original (solo imagen)
    function resetModalToImageOnly() {
      if (currentVideoElement) {
        currentVideoElement.pause();
        currentVideoElement.remove();
        currentVideoElement = null;
      }
      modalImg.style.display = '';    // aseguramos que se vea
      modalImg.src = '';
      modalImg.alt = '';
      modalImg.style.opacity = '0';
    }

    function openModal(itemsArray, startIndex) {
      if (!modal || !modalImg) return;
      currentItems = itemsArray;
      currentIndex = startIndex;
      resetModalToImageOnly();    // limpia cualquier vídeo previo
      updateModalMedia();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function updateModalMedia() {
      if (!currentItems.length || !currentItems[currentIndex]) return;
      const item = currentItems[currentIndex];

      // Reseteamos el estado visual
      resetModalToImageOnly();

      if (item.type === 'image') {
        // Mostramos la imagen dentro del <img> existente
        modalImg.style.display = 'block';
        modalImg.style.opacity = '0';
        modalImg.src = item.src;
        modalImg.alt = item.alt;
        modalImg.onload = () => {
          modalImg.style.opacity = '1';
        };
        modalImg.onerror = () => {
          modalImg.onerror = null;
          modalImg.src = '/images/fallback.webp'; // imagen por defecto
        };
      } 
      else if (item.type === 'video') {
        // Ocultamos la imagen y creamos un <video> en su lugar
        modalImg.style.display = 'none';
        const video = document.createElement('video');
        video.src = item.src;
        video.controls = true;
        video.autoplay = true;
        video.loop = false;
        video.muted = false;
        video.className = 'max-w-full max-h-[85vh] object-contain rounded-2xl shadow-2xl';
        video.style.display = 'block';
        video.onerror = () => {
          video.onerror = null;
          video.src = '/video.mp4';   // placeholder universal
          video.load();
          video.play().catch(e => console.warn('Placeholder autoplay error', e));
        };
        // Insertamos el vídeo justo después del contenedor de la imagen (dentro del mismo div)
        const parentDiv = modalImg.parentNode;
        parentDiv.appendChild(video);
        currentVideoElement = video;
        video.play().catch(e => console.warn('Autoplay bloqueado:', e));
      }

      // Actualizar contador
      if (modalCounter) {
        modalCounter.textContent = `${currentIndex+1} / ${currentItems.length}`;
      }
    }

    function nextMedia() {
      if (currentItems.length === 0) return;
      currentIndex = (currentIndex + 1) % currentItems.length;
      updateModalMedia();
    }

    function prevMedia() {
      if (currentItems.length === 0) return;
      currentIndex = (currentIndex - 1 + currentItems.length) % currentItems.length;
      updateModalMedia();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      resetModalToImageOnly();
    }

    // Eventos
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (nextBtn) nextBtn.addEventListener('click', nextMedia);
    if (prevBtn) prevBtn.addEventListener('click', prevMedia);
    document.addEventListener('keydown', (e) => {
      if (!modal || modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowRight') nextMedia();
      if (e.key === 'ArrowLeft') prevMedia();
    });

    // Click en cards (lee data-type, data-src, data-alt, data-id)
    document.querySelectorAll('.gc-card').forEach(card => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        const block = card.closest('.relative.py-12');
        if (!block) return;
        const uniqueItems = [];
        const seen = new Set();
        block.querySelectorAll('.gc-card').forEach(c => {
          const id = c.dataset.id;
          if (!seen.has(id)) {
            seen.add(id);
            uniqueItems.push({
              src: c.dataset.src,
              alt: c.dataset.alt,
              badge: c.dataset.badge,
              type: c.dataset.type,    // "image" o "video"
              id: id
            });
          }
        });
        const clickedId = card.dataset.id;
        const clickedIndex = uniqueItems.findIndex(item => item.id === clickedId);
        if (clickedIndex !== -1) {
          openModal(uniqueItems, clickedIndex);
        }
      });
    });
  })();
</script>