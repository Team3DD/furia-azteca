---
// AboutGallery.astro
// Galería multimedia con imágenes y videos (con TypeScript no intrusivo)
interface GalleryItem {
  id: number | string;
  type: 'image' | 'video';
  src: string;
  videoUrl?: string;
  alt: string;
  badge?: string;
}

const defaultItems: GalleryItem[] = [
  { id: 1, type: 'image', src: 'https://picsum.photos/id/104/800/600', alt: 'Jugadores en concentración', badge: 'Detrás de cámaras' },
  { id: 2, type: 'image', src: 'https://picsum.photos/id/40/800/600', alt: 'Afición en el estadio', badge: 'Pasión' },
  { id: 3, type: 'video', src: 'https://img.youtube.com/vi/dQw4w9WgXcQ/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ', alt: 'Momento especial', badge: 'Video' },
  { id: 4, type: 'image', src: 'https://picsum.photos/id/15/800/600', alt: 'Entrenamiento', badge: 'Preparación' },
  { id: 5, type: 'video', src: 'https://img.youtube.com/vi/9bZkp7q19f0/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=9bZkp7q19f0', alt: 'Celebración', badge: 'Emoción' },
  { id: 6, type: 'image', src: 'https://picsum.photos/id/20/800/600', alt: 'Conferencia', badge: 'Rueda de prensa' },
];

const { title = "Galería Multimedia", subtitle = "Imágenes y videos exclusivos", items = defaultItems } = Astro.props;
---

<section class="bg-carbon w-full py-16 md:py-24">
  <div class="container mx-auto px-4 md:px-8">
    <header class="text-center mb-12 md:mb-16">
      <span class="section-label text-dorado text-sm uppercase tracking-[0.2em] font-display">Revive los momentos</span>
      <h2 class="section-title text-crema text-3xl md:text-4xl lg:text-5xl font-bold mt-2">{title}</h2>
      {subtitle && <p class="text-crema/70 mt-4 max-w-2xl mx-auto">{subtitle}</p>}
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 auto-rows-fr">
      {items.map((item: GalleryItem) => (
        <button
          class="group relative aspect-video overflow-hidden rounded-lg bg-carbon-light shadow-lg transition-all duration-300 hover:shadow-2xl hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-dorado/50"
          data-gallery-item
          data-id={item.id}
          data-type={item.type}
          data-src={item.src}
          data-video-url={item.videoUrl || ''}
          data-alt={item.alt}
          data-badge={item.badge || ''}
          aria-label={`Abrir ${item.type === 'video' ? 'video' : 'imagen'}: ${item.alt}`}
        >
          <img src={item.src} alt={item.alt} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          
          {item.badge && (
            <div class="absolute top-3 left-3 z-10">
              <span class="inline-block font-display text-[11px] sm:text-xs uppercase tracking-wider bg-dorado text-carbon px-2 py-1 rounded-sm">{item.badge}</span>
            </div>
          )}
          
          {item.type === 'video' && (
            <div class="absolute inset-0 flex items-center justify-center z-10">
              <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-dorado/90 text-carbon flex items-center justify-center transition-transform group-hover:scale-110 group-hover:bg-dorado">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 md:w-8 md:h-8 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor" /></svg>
              </div>
            </div>
          )}
          
          <div class="absolute bottom-0 left-0 right-0 p-3 translate-y-full group-hover:translate-y-0 transition-transform duration-300 bg-gradient-to-t from-black/80 to-transparent z-10">
            <p class="text-white text-xs md:text-sm font-display truncate">{item.alt}</p>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Modal lightbox unificado -->
<div id="about-gallery-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md">
  <div class="relative w-full max-w-5xl max-h-[90vh]">
    <button id="about-modal-close" class="absolute -top-12 right-0 md:-right-12 md:top-0 text-dorado hover:text-white bg-black/40 hover:bg-black/60 rounded-full w-10 h-10 flex items-center justify-center text-2xl transition-all">✕</button>
    <button id="about-modal-prev" class="absolute left-2 top-1/2 -translate-y-1/2 md:-left-14 bg-black/40 hover:bg-black/60 rounded-full w-12 h-12 flex items-center justify-center text-dorado text-3xl">‹</button>
    <div class="flex items-center justify-center w-full h-full rounded-xl overflow-hidden bg-black/40">
      <div id="about-modal-content" class="w-full h-full flex items-center justify-center"></div>
    </div>
    <button id="about-modal-next" class="absolute right-2 top-1/2 -translate-y-1/2 md:-right-14 bg-black/40 hover:bg-black/60 rounded-full w-12 h-12 flex items-center justify-center text-dorado text-3xl">›</button>
    <div class="absolute -bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1">
      <p id="about-modal-counter" class="text-dorado text-xs tracking-wider font-mono"></p>
      <p id="about-modal-caption" class="text-crema/80 text-sm max-w-md text-center hidden md:block"></p>
    </div>
  </div>
</div>

<style is:global>
  .video-responsive {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 56.25%;
  }
  .video-responsive iframe,
  .video-responsive video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 0.75rem;
  }
</style>

<script lang="js">
// @ts-nocheck
(function() {
  const modal = document.getElementById('about-gallery-modal');
  const modalContent = document.getElementById('about-modal-content');
  const closeBtn = document.getElementById('about-modal-close');
  const prevBtn = document.getElementById('about-modal-prev');
  const nextBtn = document.getElementById('about-modal-next');
  const counterSpan = document.getElementById('about-modal-counter');
  const captionSpan = document.getElementById('about-modal-caption');

  let galleryItems = [];
  let currentIndex = 0;
  let currentMediaElement = null;

  function collectGalleryItems() {
    const buttons = document.querySelectorAll('[data-gallery-item]');
    const items = [];
    buttons.forEach(btn => {
      items.push({
        type: btn.dataset.type,
        src: btn.dataset.src,
        videoUrl: btn.dataset.videoUrl || '',
        alt: btn.dataset.alt || '',
        badge: btn.dataset.badge || '',
        id: btn.dataset.id
      });
    });
    return items;
  }

  function renderModalContent(item) {
    if (!modalContent) return;
    if (currentMediaElement) {
      if (currentMediaElement.tagName === 'IFRAME') currentMediaElement.src = '';
      else if (currentMediaElement.tagName === 'VIDEO') currentMediaElement.pause();
      currentMediaElement = null;
    }
    modalContent.innerHTML = '';

    if (item.type === 'image') {
      const img = document.createElement('img');
      img.src = item.src;
      img.alt = item.alt;
      img.className = 'max-w-full max-h-[85vh] object-contain rounded-lg shadow-2xl transition-opacity duration-200';
      img.style.opacity = '0';
      img.onload = () => img.style.opacity = '1';
      modalContent.appendChild(img);
      currentMediaElement = img;
    }
    else if (item.type === 'video' && item.videoUrl) {
      const url = item.videoUrl;
      let embedUrl = '';
      if (url.includes('youtube.com/watch') || url.includes('youtu.be')) {
        let videoId = '';
        if (url.includes('youtu.be')) videoId = url.split('/').pop()?.split('?')[0] || '';
        else videoId = new URLSearchParams(url.split('?')[1]).get('v') || '';
        if (videoId) embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      } else if (url.includes('vimeo.com')) {
        const vimeoId = url.split('/').pop()?.split('?')[0] || '';
        if (vimeoId) embedUrl = `https://player.vimeo.com/video/${vimeoId}?autoplay=1`;
      } else if (/\.(mp4|webm|ogg)$/i.test(url)) {
        const video = document.createElement('video');
        video.src = url;
        video.controls = true;
        video.autoplay = true;
        video.className = 'w-full max-h-[85vh] rounded-lg';
        modalContent.appendChild(video);
        currentMediaElement = video;
        video.play().catch(e => console.warn(e));
        if (counterSpan) counterSpan.textContent = `${currentIndex+1} / ${galleryItems.length}`;
        if (captionSpan) captionSpan.textContent = item.alt;
        return;
      }
      if (embedUrl) {
        const container = document.createElement('div');
        container.className = 'video-responsive';
        const iframe = document.createElement('iframe');
        iframe.src = embedUrl;
        iframe.title = item.alt;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        container.appendChild(iframe);
        modalContent.appendChild(container);
        currentMediaElement = iframe;
      } else {
        const errorDiv = document.createElement('div');
        errorDiv.className = 'text-white text-center p-8';
        errorDiv.innerText = 'No se pudo cargar el video.';
        modalContent.appendChild(errorDiv);
      }
    }
    if (counterSpan) counterSpan.textContent = `${currentIndex+1} / ${galleryItems.length}`;
    if (captionSpan) captionSpan.textContent = item.alt;
  }

  function openModal(index) {
    if (!modal || galleryItems.length === 0) return;
    currentIndex = (index + galleryItems.length) % galleryItems.length;
    renderModalContent(galleryItems[currentIndex]);
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = '';
    if (currentMediaElement) {
      if (currentMediaElement.tagName === 'IFRAME') currentMediaElement.src = '';
      else if (currentMediaElement.tagName === 'VIDEO') currentMediaElement.pause();
      currentMediaElement = null;
    }
    if (modalContent) modalContent.innerHTML = '';
  }

  function nextItem() { if (galleryItems.length) { currentIndex = (currentIndex + 1) % galleryItems.length; renderModalContent(galleryItems[currentIndex]); } }
  function prevItem() { if (galleryItems.length) { currentIndex = (currentIndex - 1 + galleryItems.length) % galleryItems.length; renderModalContent(galleryItems[currentIndex]); } }

  closeBtn?.addEventListener('click', closeModal);
  nextBtn?.addEventListener('click', nextItem);
  prevBtn?.addEventListener('click', prevItem);
  document.addEventListener('keydown', (e) => {
    if (!modal || modal.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowRight') nextItem();
    if (e.key === 'ArrowLeft') prevItem();
  });
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  function init() {
    galleryItems = collectGalleryItems();
    document.querySelectorAll('[data-gallery-item]').forEach((card, idx) => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        const found = galleryItems.findIndex(i => i.id === card.dataset.id);
        openModal(found !== -1 ? found : idx);
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>