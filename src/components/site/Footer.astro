---
// src/components/site/Footer.astro
import { Button } from "../ui/button";

const currentYear = new Date().getFullYear();

// Configuración de marca
const brand = {
  name: 'International Fans Club',
  shortName: 'IFC',
  tagline: 'La experiencia mundialista',
  href: '/',
  ariaLabel: 'International Fans Club - Inicio',
  logo: '/logo.png?v=2'
};

// Enlaces de navegación
const directLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/#about' },
  { label: 'Historia', href: '/historia' },
  { label: 'Contacto', href: '/#formulario' }
];

// Enlaces del footer por sección
const footerLinks = {
  internacional: [
    { label: 'Ediciones anteriores', href: '/internacional/anteriores' },
    { label: 'Clasificatorias', href: '/internacional/clasificatorias' },
    { label: 'Selecciones', href: '/internacional/selecciones' }
  ],
  legal: [
    { label: 'Aviso de privacidad', href: '/legal/privacidad' },
    { label: 'Términos y condiciones', href: '/legal/terminos' },
    { label: 'Cookies', href: '/legal/cookies' }
  ]
};

// Redes sociales
const socialLinks = [
  { label: 'Instagram', href: 'https://instagram.com/internationalfansclub', abbr: 'IG' },
  { label: 'Facebook', href: 'https://facebook.com/internationalfansclub', abbr: 'FB' },
  { label: 'Twitter/X', href: 'https://twitter.com/internationalfansclub', abbr: 'X' },
  { label: 'YouTube', href: 'https://youtube.com/internationalfansclub', abbr: 'YT' }
];

// Utilidad para capitalizar
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Columnas dinámicas (excluyendo 'legal')
const columnGroups = Object.entries(footerLinks).filter(([key]) => key !== 'legal');

// Clases reutilizables para título y lista (alineación responsive)
const titleClasses = "font-display text-xs uppercase tracking-[0.2em] text-dorado mb-4 text-center lg:text-left";
const listClasses = "space-y-2 text-center lg:text-left";
const linkClasses = "font-body text-sm text-white/40 hover:text-white transition-colors";
---

<footer class="bg-carbon border-t border-white/10">
  <div class="h-[3px] bg-gradient-to-r from-transparent via-dorado to-transparent rounded-full mb-2" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-6 py-16">
    <!-- Grid responsivo -->
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">

      <!-- Columna identidad (centrada en móvil/tablet, izquierda en desktop) -->
      <div class="flex flex-col items-center text-center md:col-span-2 lg:col-span-2 lg:items-start lg:text-left">
        <a href={brand.href} class="flex flex-col md:flex-row items-center gap-4 mb-5 group" aria-label={brand.ariaLabel}>
          <div class="overflow-hidden w-20 h-20 flex items-center justify-center shrink-0 bg-carbon/50">
            <img src={brand.logo} alt={brand.name} class="w-full h-full object-contain" loading="lazy" />
          </div>
          <div>
            <span class="block font-display text-white uppercase tracking-widest text-base leading-none group-hover:text-dorado transition-colors">
              {brand.name}
            </span>
            <span class="block font-body text-white/30 text-xs mt-0.5">
              {brand.tagline}
            </span>
          </div>
        </a>

        <p class="text-white/40 text-sm font-body leading-relaxed max-w-xs mb-6">
          La comunidad internacional de aficionados al fútbol que vive los mundiales como ningún otro.
          Rusia 2018 · Qatar 2022 · 2026.
        </p>

        <!-- Redes sociales con efecto romboidal -->
        <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
          {socialLinks.map(({ label, href, abbr }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              class="group rhomboid rhomboid-corners rhomboid-hover w-8 h-8 border border-white/20 flex items-center justify-center transition-all hover:bg-dorado hover:border-dorado"
            >
              <span class="rhomboid-content font-display text-xs text-white/40 group-hover:text-carbon">
                {abbr}
              </span>
            </a>
          ))}
        </div>
      </div>

      <!-- Navegación -->
      <div>
        <h3 class={titleClasses}>Navegación</h3>
        <ul class={listClasses}>
          {directLinks.map(({ label, href }) => (
            <li>
              <a href={href} class={linkClasses}>{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Secciones dinámicas (Internacional, etc.) -->
      {columnGroups.map(([section, links]) => (
        <div>
          <h3 class={titleClasses}>{capitalize(section)}</h3>
          <ul class={listClasses}>
            {links.map(({ label, href }) => (
              <li>
                <a href={href} class={linkClasses}>{label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- CTA "Rumbo al Mundial" (romboidal solo en tablet/desktop) -->
    <div class="mt-16 border border-crema/30 bg-crema/5 p-8 transition-all hover:border-dorado/50 md:rhomboid rhomboid-corners md:mx-4 lg:mx-0">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 md:skew-x-[15deg]">
        <div>
          <p class="section-label mb-1">Rumbo al Mundial</p>
          <p class="font-display text-white text-2xl uppercase leading-none">
            México · USA · Canadá 2026
          </p>
        </div>
        <Button href="/mundiales/2026" variant="solid" color="dorado" size="md">
          Ver proyecto 2026
        </Button>
      </div>
    </div>

    <!-- Bottom bar (derechos + enlaces legales) -->
    <div class="mt-10 pt-6 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-white/20 text-xs font-body">
        © {currentYear} {brand.name} — {brand.tagline}. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-4">
        {footerLinks.legal.map(({ label, href }) => (
          <a href={href} class="text-white/20 text-xs hover:text-white/50 transition-colors font-body">
            {label}
          </a>
        ))}
      </div>
    </div>

    <!-- Crédito DAUC con efecto de scroll -->
    <div class="text-center mt-8 pt-4">
      <p class="text-white/30 text-sm font-body">
        Design and development by
        <span id="daucCredit" class="text-crema font-medium transition-all duration-300 cursor-default" style="text-shadow: 0 0 0 transparent;">
          DAUC
        </span>
      </p>
    </div>
  </div>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dauc = document.getElementById('daucCredit');
    if (dauc) {
      window.addEventListener('scroll', () => {
        const scrollY = window.scrollY;
        const intensity = Math.min(scrollY / 300, 1);
        const g = 206 + Math.floor(intensity * (250 - 206));
        const b = 235 + Math.floor(intensity * (255 - 235));
        dauc.style.color = `rgb(135, ${g}, ${b})`;
        dauc.style.textShadow = `0 0 ${intensity * 4}px skyblue`;
      });
    }
  });
</script>