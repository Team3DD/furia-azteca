---
// src/components/site/Header.astro
import { Button } from "../ui/button";

const brand = {
  name: " InternationalFansCup",
  shortName: "FA",
  href: "/",
  ariaLabel: "Ir al inicio",
};

const topbar = {
  label: "Selección Mexicana de Aficionados",
  social: [
    { id: "fb", label: "FB", href: "https://facebook.com", ariaLabel: "Facebook" },
    { id: "ig", label: "IG", href: "https://instagram.com", ariaLabel: "Instagram" },
    { id: "tw", label: "X",  href: "https://x.com",        ariaLabel: "Twitter" },
  ],
  accent: { label: "Newsletter", href: "/newsletter" },
};

const mainNav = [
  { id: "about",      label: "Nosotros",   href: "/#about" },
  { id: "degree",     label: "Historia", href: "/#historia" },
  {
    id: "events",
    label: "Eventos",
    children: [
      { label: "Próximos eventos", href: "/eventos/proximos" },
      { label: "Próximamente",        href: "/eventos/Próximamente", accent: true },
    ],
  },
];

const cta  = { label: "Contacto", href: "/#formulario" };
const a11y = { navLabel: "Navegación principal" };

const normalizedNav = mainNav.map((item) => ({
  ...item,
  href: item.children ? undefined : item.href || "#",
}));
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 w-full">

  <!-- Topbar (sin cambios) -->
  <div class="hidden lg:block bg-carbon border-b border-white/5">
    <div class="md:w-4xl lg:w-7xl mx-auto  flex justify-between items-center h-8">
      <span class="font-body text-white/80 text-sm uppercase tracking-[0.2em]">
        {topbar.label}
      </span>
      <div class="flex items-center gap-4">
        {topbar.social.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.ariaLabel}
            class="font-display text-sm uppercase tracking-widest text-white/80 hover:text-dorado transition-colors"
          >
            {s.label}
          </a>
        ))}
        <span class="w-px h-3 bg-white/10" aria-hidden="true" />
        <a
          href={topbar.accent.href}
          class="font-display text-sm uppercase tracking-widest text-dorado hover:text-dorado-light transition-colors"
        >
          {topbar.accent.label}
        </a>
      </div>
    </div>
  </div>

  <div
    class="h-[3px] bg-gradient-to-r from-transparent via-dorado to-transparent rounded-full mb-2"
    aria-hidden="true"
  />

  <div class="header-bar mx-auto px-6 flex items-center">

    <a href={brand.href} class="header-logo-block" aria-label={brand.ariaLabel}>
      <div class="logo-content">
        <div class="logo-icon-wrap">
          <img src="/logo.PNG" alt={brand.shortName} class="logo-img" />
        </div>
        <span class="font-display text-carbon uppercase text-md tracking-[0.2em] brand-name leading-tight">
          <span class="hidden lg:inline">International Fans Cup</span>
          <span class="lg:hidden">IFC</span>
        </span>
      </div>
    </a>

    <div class="flex-1" aria-hidden="true" />

    <div class="header-nav-block">
      <div class="nav-content">
        <nav class="hidden lg:flex items-center gap-1" aria-label={a11y.navLabel}>
          {normalizedNav.map((item) => (
            <div class="relative group">
              {item.children ? (
                <>
                  <button class="flex items-center gap-1 px-3 py-2 font-display text-md uppercase tracking-[0.15em] text-carbon/70 hover:text-verde transition-colors whitespace-nowrap">
                    {item.label}
                    <svg
                      class="w-2 h-2 ml-1 opacity-50 group-hover:opacity-100 transition-transform duration-200 group-hover:rotate-180"
                      viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="2"
                    >
                      <path stroke-linecap="round" d="M1 1l4 4 4-4" />
                    </svg>
                  </button>
                  <div class="absolute top-full left-0 min-w-[180px] bg-crema border border-crema/10 shadow-xl opacity-0 invisible pointer-events-none group-hover:opacity-100 group-hover:visible group-hover:pointer-events-auto transition-all duration-200 z-50">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class="block px-4 py-2 font-body text-md text-carbon/70 hover:bg-carbon/5 hover:text-verde transition-colors border-b border-carbon/5 last:border-0"
                      >
                        {child.accent && <span class="mr-1.5 text-dorado" aria-hidden="true">●</span>}
                        {child.label}
                      </a>
                    ))}
                  </div>
                </>
              ) : (
                <a
                  href={item.href}
                  class="px-3 py-2 font-display text-md uppercase tracking-[0.15em] text-carbon/70 hover:text-verde transition-colors whitespace-nowrap"
                >
                  {item.label}
                </a>
              )}
            </div>
          ))}
        </nav>

        <Button href={cta.href} variant="solid" color="dorado" size="lg" className="hidden lg:inline-flex">
          {cta.label}
        </Button>

        <label for="mobile-menu" class="lg:hidden w-8 h-8 flex flex-col justify-center gap-1.5 cursor-pointer" aria-label="Abrir menú">
          <span class="block h-0.5 w-6 bg-carbon" />
          <span class="block h-0.5 w-6 bg-carbon" />
          <span class="block h-0.5 w-6 bg-carbon" />
        </label>
      </div>
    </div>

  </div>
</header>

<input type="checkbox" id="mobile-menu" class="hidden peer" />
<div
  class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm hidden peer-checked:block"
  aria-hidden="true"
>
  <label for="mobile-menu" class="absolute inset-0 cursor-pointer" />
</div>

<!-- Drawer móvil (fondo carbon, textos crema, se mantiene) -->
<aside class="fixed top-0 right-0 bottom-0 w-full max-w-sm bg-carbon-mid border-l border-crema/10 z-50 flex flex-col shadow-2xl transition-transform duration-300 ease-in-out translate-x-full peer-checked:translate-x-0">
  <div class="flex justify-between items-center p-5 border-b border-crema/10">
    <span class="font-display text-crema text-lg uppercase tracking-wider">{brand.name}</span>
    <label for="mobile-menu" class="text-crema/60 hover:text-crema text-2xl cursor-pointer leading-none" aria-label="Cerrar menú">&times;</label>
  </div>

  <nav class="flex-1 overflow-y-auto py-4 space-y-2" aria-label={a11y.navLabel}>
    {normalizedNav.map((item) => (
      <div class="mobile-nav-item">
        {item.children ? (
          <>
            <button class="mobile-nav-toggle w-full flex justify-between items-center px-5 py-4 font-display text-sm uppercase tracking-wider text-crema/80 hover:text-crema transition-colors">
              {item.label}
              <svg class="w-3 h-3 text-crema/60 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="mobile-submenu hidden pl-6 pb-3 space-y-2">
              {item.children.map((child) => (
                <a href={child.href} class="block py-3 font-body text-sm text-crema/60 hover:text-crema transition-colors">
                  {child.accent && <span class="mr-1.5 text-dorado" aria-hidden="true">●</span>}
                  {child.label}
                </a>
              ))}
            </div>
          </>
        ) : (
          <a href={item.href} class="block px-5 py-4 font-display text-sm uppercase tracking-wider text-crema/80 hover:text-crema transition-colors">
            {item.label}
          </a>
        )}
      </div>
    ))}
  </nav>

  <div class="p-5 border-t border-crema/10">
    <Button href={cta.href} variant="solid" color="carbon" size="md" className="w-full justify-center">
      {cta.label}
    </Button>
  </div>
</aside>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });
  }

  document.querySelectorAll('.mobile-nav-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const submenu = btn.nextElementSibling;
      const arrow   = btn.querySelector('svg');
      if (!submenu) return;
      const open = submenu.classList.toggle('hidden');
      if (arrow) arrow.style.transform = open ? 'rotate(0deg)' : 'rotate(180deg)';
    });
  });
</script>

<style is:global>
  :root {
    --skew: -15deg;
    --r-acute:  4px;
    --r-obtuse: 12px;
    --crema: #e8e0d0;      
    --hdr-h: clamp(64px, 12vw, 96px);
    --logo-size: 4rem;
    --logo-size-scrolled: 7rem;
    --ease: 0.3s ease;
  }

  /* ─── BARRA ─── */
  .header-bar {
    display: flex;
    align-items: stretch;
    width: 100%;
    height: var(--hdr-h);
    overflow: visible;
    transition: height var(--ease);
  }

  /* ─── BLOQUE LOGO (fondo crema) ─── */
  .header-logo-block {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    background: var(--crema);
    border-radius: var(--r-obtuse) var(--r-acute) var(--r-obtuse) var(--r-acute);
    transform: skewX(var(--skew));
    transform-origin: left center;
    overflow: visible;
    transition: transform var(--ease), border-radius var(--ease), box-shadow var(--ease);
    box-shadow: 4px 6px 20px rgba(0, 0, 0, 0.35), 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  /* Contra-rotación: todo el contenido queda vertical */
  .logo-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 2.5rem 0 1.5rem;
    transform: skewX(calc(var(--skew) * -1));
    transition: transform var(--ease), padding var(--ease);
  }

  /* ─── LOGO IMG ─── */
  .logo-icon-wrap {
    width: var(--logo-size);
    height: var(--logo-size);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    transition: width var(--ease), height var(--ease);
  }

  .logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    overflow: visible;
  }

  /* ─── BRAND NAME (texto carbon) ─── */
  .brand-name {
    font-size: 1.5rem;
    white-space: nowrap;
    transition: font-size var(--ease);
  }

  /* ─── BLOQUE NAV (fondo crema) ─── */
  .header-nav-block {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    background: var(--crema);  
    border-radius: var(--r-obtuse) var(--r-acute) var(--r-obtuse) var(--r-acute);
    transform: skewX(var(--skew));
    transform-origin: right center;
    transition: transform var(--ease), border-radius var(--ease);
    box-shadow: 4px 6px 20px rgba(0, 0, 0, 0.35), 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .nav-content {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 1.5rem 0 2.5rem;
    transform: skewX(calc(var(--skew) * -1));
    transition: transform var(--ease), padding var(--ease);
  }

  /* ─── SCROLL (solo desktop) ─── */
  @media (min-width: 1024px) {
    #site-header.scrolled .header-bar     { height: 66px; }
    #site-header.scrolled .logo-icon-wrap { width: var(--logo-size-scrolled); height: var(--logo-size-scrolled); }
    #site-header.scrolled .brand-name     { font-size: 0.9rem; }
    #site-header.scrolled .logo-content   { padding-right: 2rem; }
  }

  /* ─── DRAWER MÓVIL ─── */
  .translate-x-full             { transform: translateX(100%); }
  .peer-checked\:translate-x-0 { transform: translateX(0); }
  .mobile-submenu.hidden        { display: none; }
</style>